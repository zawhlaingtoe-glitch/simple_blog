<%- include('partials/header') %>

<%
const latestPosts = Array.isArray(posts) ? posts : [];
const heroPost = latestPosts[0];
%>

<main>
    <section class="hero-shell">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 animate-fade-in-up">
                    <span class="section-label d-inline-block mb-2">Developer stories and practical notes</span>
                    <h1 class="hero-title mb-3">Build cleaner apps, one post at a time.</h1>
                    <p class="hero-copy mb-3">
                        A focused space for sharing backend lessons, frontend patterns, debugging stories, and project updates from the TECHBLOG community.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <a href="/posts" class="btn btn-brand"><i class="bi bi-journal-text me-2"></i>Explore Posts</a>
                        <% if (!locals.isLoggedIn) { %>
                            <a href="/users/register" class="btn btn-outline-brand"><i class="bi bi-person-plus me-2"></i>Join Community</a>
                        <% } %>
                    </div>
                </div>

                <div class="col-lg-5 animate-fade-in-up delay-200">
                    <div class="hero-panel">
                        <div class="code-window p-3 p-md-4">
                            <div class="d-flex gap-2 mb-3">
                                <span class="window-dot"></span>
                                <span class="window-dot"></span>
                                <span class="window-dot"></span>
                            </div>
                            <div class="code-line">const latestPost = {</div>
                            <div class="code-line">  title: "<%= heroPost ? heroPost.title : 'Write your first post' %>",</div>
                            <div class="code-line">  author: "<%= heroPost ? heroPost.author : 'TECHBLOG' %>",</div>
                            <div class="code-line">  status: "published",</div>
                            <div class="code-line">  source: "database"</div>
                            <div class="code-line">};</div>

                            <div class="row g-0 metric-box mt-3 pt-3 text-white">
                                <div class="col-4">
                                    <strong class="d-block fs-5"><%= latestPosts.length %></strong>
                                    <span class="text-white-50 small">Shown</span>
                                </div>
                                <div class="col-4">
                                    <strong class="d-block fs-5"><%= latestPosts.filter(post => post.photo).length %></strong>
                                    <span class="text-white-50 small">Photos</span>
                                </div>
                                <div class="col-4">
                                    <strong class="d-block fs-5"><%= new Set(latestPosts.map(post => post.author)).size %></strong>
                                    <span class="text-white-50 small">Authors</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-4">
        <div class="container">
            <div class="hero-panel p-4 animate-fade-in-up mb-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-5">
                        <span class="section-label d-inline-block mb-1">Search the blog</span>
                        <h4 class="fw-bold mb-0">Find what you need.</h4>
                    </div>
                    <div class="col-md-7">
                        <form action="/posts/search" method="GET" role="search">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search text-muted"></i></span>
                                <input class="form-control" type="search" name="q" placeholder="Search by title or content..." aria-label="Search posts" style="font-size:0.9rem;">
                                <button class="btn btn-brand" type="submit">Search</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <% if (typeof popularTags !== 'undefined' && popularTags && popularTags.length > 0) { %>
                <div class="hero-panel p-3 animate-fade-in-up mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="icon-box"><i class="bi bi-tags"></i></span>
                        <span class="section-label">Popular topics</span>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        <% popularTags.forEach(function(tag) { %>
                            <a href="/posts/tag/<%= tag.slug %>" class="tag-pill" style="font-size:0.78rem;">
                                #<%= tag.name %> <span class="text-muted" style="font-weight:400;font-size:0.7rem;">(<%= tag.post_count %>)</span>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <div class="row align-items-end mb-4 g-3">
                <div class="col-lg-7 animate-fade-in-up">
                    <span class="section-label">Why read here</span>
                    <h2 class="fw-bold mt-2 mb-0">Everything stays practical.</h2>
                </div>
                <div class="col-lg-5 text-lg-end animate-fade-in-up delay-100">
                    <p class="text-muted mb-0">Short guides, real project context, and ideas you can use in your next commit.</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-4 animate-fade-in-up">
                    <div class="feature-card p-3">
                        <span class="icon-box mb-2"><i class="bi bi-terminal"></i></span>
                        <h5 class="fw-bold">Code-first posts</h5>
                        <p class="text-muted mb-0">Examples are written for builders, with enough detail to copy the idea into a real app.</p>
                    </div>
                </div>
                <div class="col-md-4 animate-fade-in-up delay-100">
                    <div class="feature-card p-3">
                        <span class="icon-box mb-2"><i class="bi bi-lightning-charge"></i></span>
                        <h5 class="fw-bold">Fast lessons</h5>
                        <p class="text-muted mb-0">Quick reads for routing, models, auth, validation, deployment, and small design improvements.</p>
                    </div>
                </div>
                <div class="col-md-4 animate-fade-in-up delay-200">
                    <div class="feature-card p-3">
                        <span class="icon-box mb-2"><i class="bi bi-chat-square-text"></i></span>
                        <h5 class="fw-bold">Community voice</h5>
                        <p class="text-muted mb-0">Members can register, write, and keep the knowledge base growing with fresh notes.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-4">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
                <div class="animate-fade-in-up">
                    <span class="section-label">Latest posts</span>
                    <h2 class="fw-bold mt-2 mb-0">Fresh from real users.</h2>
                </div>
                <a href="/posts" class="btn btn-outline-brand animate-fade-in-up delay-100"><i class="bi bi-arrow-right me-2"></i>View All Posts</a>
            </div>

            <% if (latestPosts.length === 0) { %>
                <div class="hero-panel p-5 text-center animate-scale-in">
                    <span class="icon-box mb-3"><i class="bi bi-journal-plus fs-5"></i></span>
                    <h4 class="fw-bold">No posts yet</h4>
                    <p class="text-muted mb-4">Publish the first story and it will appear here.</p>
                    <a href="/posts/create" class="btn btn-brand"><i class="bi bi-plus-circle me-2"></i>Create Post</a>
                </div>
                <% } else { %>
                    <div class="row g-3">
                        <% latestPosts.forEach((post, index) => {
                            const delayClass = index === 0 ? '' : index === 1 ? 'delay-100' : 'delay-200';
                            const postExcerpt = post.content ? post.content.replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim() : '';
                            const postTags = post.tags || [];
                        %>
                            <div class="col-lg-4 animate-fade-in-up <%= delayClass %>">
                                <a href="/posts/<%= post.id %>" class="text-decoration-none text-reset d-block h-100">
                                    <article class="article-card smart-post-card overflow-hidden">
                                        <div class="smart-post-media">
                                            <% if (post.photo) { %>
                                                <img src="/upload/<%= post.photo %>" alt="<%= post.title %>">
                                            <% } else { %>
                                                <div class="h-100 d-flex align-items-center justify-content-center">
                                                    <span class="icon-box"><i class="bi bi-image"></i></span>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="smart-post-body">
                                            <span class="tag align-self-start">
                                                <% if (post.author_photo) { %>
                                                    <img src="/upload/<%= post.author_photo %>" alt="<%= post.author %>" class="me-2" style="width:18px;height:18px;border-radius:50%;object-fit:cover;">
                                                <% } %>
                                                <%= post.author || 'Unknown author' %>
                                            </span>
                                            <% if (postTags.length > 0) { %>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <% postTags.slice(0, 3).forEach(function(tag) { %>
                                                        <span class="tag-pill">#<%= tag.name %></span>
                                                    <% }) %>
                                                </div>
                                            <% } %>
                                            <h4 class="fw-bold smart-post-title"><%= post.title %></h4>
                                            <p class="smart-post-excerpt">
                                                <%= postExcerpt || 'Open the detail page to read this post.' %>
                                            </p>
                                            <div class="smart-post-footer">
                                                <span class="article-meta smart-post-date">
                                                    <i class="bi bi-calendar3 me-1"></i>
                                                    <%= post.created_at ? new Date(post.created_at).toLocaleDateString() : 'Just now' %>
                                                </span>
                                                <span style="display:inline-flex;align-items:center;gap:0.5rem;">
                                                    <span class="article-meta"><i class="bi bi-clock-history me-1"></i><%= locals.readingTime ? locals.readingTime(post.content) : '1 min read' %></span>
                                                    <span class="smart-post-read">
                                                        Read <i class="bi bi-arrow-right ms-1"></i>
                                                    </span>
                                                </span>
                                            </div>
                                        </div>
                                    </article>
                                </a>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </div>
    </section>

    <section class="py-5 animate-scale-in">
        <div class="container">
            <div class="newsletter-panel p-4 p-md-5">
                <div class="row align-items-center g-4">
                    <div class="col-lg-7">
                        <span class="section-label text-info">Keep learning</span>
                        <h2 class="fw-bold mt-2 mb-2">Ready to publish your first post?</h2>
                        <p class="text-white-50 mb-0">Create an account and share what you learned while building your project.</p>
                    </div>
                    <div class="col-lg-5 text-lg-end">
                        <% if (locals.isLoggedIn) { %>
                            <a href="/posts/create" class="btn btn-light fw-bold"><i class="bi bi-plus-circle me-2"></i>Create Post</a>
                        <% } else { %>
                            <a href="/users/register" class="btn btn-light fw-bold me-sm-2 mb-2 mb-sm-0"><i class="bi bi-pencil-square me-2"></i>Get Started</a>
                            <a href="/users/login" class="btn btn-outline-light fw-bold"><i class="bi bi-box-arrow-in-right me-2"></i>Login</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="footer py-4 mt-5">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div class="fw-bold text-white">TECH<span style="color: var(--accent);">BLOG</span></div>
        <div class="small">&copy; 2026 TechBlog. Built for curious developers.</div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
