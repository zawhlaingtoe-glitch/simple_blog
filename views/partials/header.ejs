<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">

    <style>
        :root {
            --ink: #17202a;
            --muted: #697386;
            --line: #e3e8ef;
            --soft: #f4f7fb;
            --brand: #2f6fed;
            --brand-dark: #2157bf;
            --accent: #0f9f8f;
            --warm: #f59e0b;
            --danger: #dc2626;
            --panel: #ffffff;
            --panel-soft: rgba(255, 255, 255, 0.78);
            --shadow-sm: 0 10px 28px rgba(17, 24, 39, 0.06);
            --shadow-md: 0 22px 55px rgba(17, 24, 39, 0.09);
        }

        * {
            letter-spacing: 0;
        }

        body {
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            font-size: 0.88rem;
            color: var(--ink);
            background:
                radial-gradient(circle at 8% 0%, rgba(47, 111, 237, 0.12), transparent 28rem),
                radial-gradient(circle at 92% 12%, rgba(15, 159, 143, 0.1), transparent 24rem),
                linear-gradient(180deg, #fbfcff 0%, var(--soft) 100%);
        }

        .navbar {
            background: rgba(255, 255, 255, 0.84);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(18px);
            box-shadow: 0 8px 26px rgba(15, 23, 42, 0.04);
        }

        .navbar-brand {
            color: var(--ink);
            font-size: 0.98rem;
            letter-spacing: 0;
        }

        .navbar-brand span {
            color: var(--accent);
        }

        .navbar-toggler {
            border: 1px solid var(--line);
            box-shadow: none;
        }

        .navbar-toggler:focus {
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.16);
        }

        .nav-link {
            color: #4b5563;
            font-size: 0.86rem;
            font-weight: 600;
            padding: 0.52rem 0.72rem !important;
            border-radius: 8px;
        }

        .nav-link:hover,
        .nav-link:focus {
            color: var(--brand);
            background: rgba(47, 111, 237, 0.08);
        }

        .nav-link i {
            color: var(--brand);
        }

        .btn-brand {
            color: #fff;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            border: 1px solid var(--brand);
            border-radius: 8px;
            font-weight: 700;
            padding: 0.6rem 0.82rem;
            box-shadow: 0 10px 24px rgba(47, 111, 237, 0.22);
        }

        .btn-brand:hover,
        .btn-brand:focus {
            color: #fff;
            background: linear-gradient(135deg, var(--brand-dark), #0d8175);
            border-color: var(--brand-dark);
            transform: translateY(-1px);
        }

        .btn-outline-brand {
            color: var(--ink);
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid var(--line);
            border-radius: 8px;
            font-weight: 700;
            padding: 0.6rem 0.82rem;
        }

        .btn-outline-brand:hover,
        .btn-outline-brand:focus {
            color: var(--brand);
            border-color: rgba(37, 99, 235, 0.38);
            background: rgba(37, 99, 235, 0.06);
        }

        .section-label {
            color: var(--accent);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .hero-shell {
            padding: 4rem 0 2.8rem;
        }

        .hero-title {
            max-width: 760px;
            font-size: clamp(1.85rem, 4.2vw, 3.15rem);
            font-weight: 800;
            line-height: 1.04;
        }

        .hero-copy {
            max-width: 620px;
            color: var(--muted);
            font-size: 0.92rem;
            line-height: 1.65;
        }

        .hero-panel,
        .feature-card,
        .article-card,
        .newsletter-panel {
            background: var(--panel-soft);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(12px);
        }

        .hero-panel {
            overflow: hidden;
        }

        .code-window {
            background: #0f172a;
            color: #dbeafe;
            min-height: 300px;
        }

        .window-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ef4444;
        }

        .window-dot:nth-child(2) {
            background: #f59e0b;
        }

        .window-dot:nth-child(3) {
            background: #22c55e;
        }

        .code-line {
            color: #93c5fd;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.8rem;
            line-height: 1.75;
            white-space: pre-wrap;
        }

        .metric-box {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .feature-card,
        .article-card {
            height: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .feature-card:hover,
        .article-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .icon-box {
            display: inline-flex;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            color: var(--brand);
            background: linear-gradient(135deg, rgba(47, 111, 237, 0.12), rgba(15, 159, 143, 0.12));
            border-radius: 8px;
        }

        .form-control,
        .form-select,
        .input-group-text {
            border-color: var(--line);
            border-radius: 8px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: rgba(47, 111, 237, 0.58);
            box-shadow: 0 0 0 0.22rem rgba(47, 111, 237, 0.14);
        }

        textarea.form-control {
            line-height: 1.7;
        }

        h1,
        .h1 {
            font-size: 1.8rem;
        }

        h2,
        .h2 {
            font-size: 1.42rem;
        }

        h3,
        .h3 {
            font-size: 1.18rem;
        }

        h4,
        .h4 {
            font-size: 1rem;
        }

        h5,
        .h5 {
            font-size: 0.94rem;
        }

        .form-label {
            font-size: 0.82rem;
            margin-bottom: 0.35rem;
        }

        .form-control,
        .form-select {
            font-size: 0.86rem;
        }

        .article-meta {
            color: var(--muted);
            font-size: 0.76rem;
            font-weight: 600;
        }

        .article-card a {
            color: var(--ink);
            text-decoration: none;
        }

        .article-card a:hover {
            color: var(--brand);
        }

        .tag {
            display: inline-flex;
            align-items: center;
            color: #0f766e;
            background: rgba(20, 184, 166, 0.1);
            border: 1px solid rgba(20, 184, 166, 0.18);
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.24rem 0.52rem;
        }

        .smart-post-card {
            display: grid;
            grid-template-rows: auto 1fr;
            min-height: 100%;
            background: #fff;
        }

        .smart-post-media {
            position: relative;
            height: 146px;
            background: linear-gradient(135deg, rgba(47, 111, 237, 0.08), rgba(15, 159, 143, 0.08)), #f5f8fb;
            overflow: hidden;
        }

        .smart-post-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

        .smart-post-card:hover .smart-post-media img {
            transform: scale(1.035);
        }

        .smart-post-body {
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            padding: 1rem;
        }

        .smart-post-title {
            font-size: 0.98rem;
            line-height: 1.35;
            margin: 0;
        }

        .smart-post-excerpt {
            color: var(--muted);
            font-size: 0.82rem;
            line-height: 1.55;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin: 0;
        }

        .smart-post-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            margin-top: auto;
            padding-top: 0.25rem;
        }

        .profile-summary-card {
            background: linear-gradient(135deg, #111827, #1d4ed8);
        }

        .profile-layout {
            align-items: start;
        }

        .profile-panel {
            position: sticky;
            top: 5rem;
        }

        .profile-post-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        .profile-post-card {
            background: #fff;
        }

        .profile-post-media {
            height: 128px;
            background: linear-gradient(135deg, rgba(47, 111, 237, 0.08), rgba(15, 159, 143, 0.08)), #f5f8fb;
        }

        .profile-post-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-post-content {
            padding: 1rem;
        }

        .feed-layout {
            display: grid;
            grid-template-columns: minmax(190px, 236px) minmax(0, 700px) minmax(220px, 292px);
            gap: 1.35rem;
            align-items: start;
        }

        .feed-sidebar {
            position: sticky;
            top: 5.5rem;
        }

        .feed-card,
        .feed-panel {
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(14px);
        }

        .feed-card {
            overflow: hidden;
            transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
        }

        .feed-card:hover {
            border-color: rgba(47, 111, 237, 0.22);
            box-shadow: var(--shadow-md);
        }

        .feed-author-photo {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            flex: 0 0 44px;
        }

        .feed-author-fallback {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            font-weight: 800;
            flex: 0 0 44px;
        }

        .feed-image {
            width: 100%;
            max-height: 520px;
            object-fit: cover;
            background: #eef3f8;
        }

        .feed-image-empty {
            min-height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                linear-gradient(135deg, rgba(47, 111, 237, 0.08), rgba(15, 159, 143, 0.08)),
                #f5f8fb;
        }

        .feed-content {
            color: var(--muted);
            display: -webkit-box;
            -webkit-line-clamp: 8;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .feed-content p:last-child {
            margin-bottom: 0;
        }

        .note-editor.note-frame {
            border-color: var(--line);
            border-radius: 8px;
            overflow: hidden;
        }

        .note-editor .note-toolbar,
        .note-editor .note-statusbar {
            background: #f8fafc;
        }

        .feed-action {
            color: #526071;
            background: transparent;
            border: 0;
            border-radius: 8px;
            font-weight: 700;
            padding: 0.76rem 0.75rem;
            text-decoration: none;
            transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
        }

        .feed-action:hover,
        .feed-action:focus {
            color: var(--brand);
            background: rgba(37, 99, 235, 0.07);
            transform: translateY(-1px);
        }

        .feed-action.is-active {
            color: var(--brand);
            background: linear-gradient(135deg, rgba(47, 111, 237, 0.12), rgba(15, 159, 143, 0.1));
        }

        .feed-action-danger:hover,
        .feed-action-danger:focus {
            color: #dc2626;
            background: rgba(220, 38, 38, 0.08);
        }

        .reaction-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            color: var(--muted);
            font-size: 0.86rem;
            border-top: 1px solid var(--line);
            padding: 0.75rem 1rem;
        }

        .reaction-stack {
            display: inline-flex;
            align-items: center;
        }

        .reaction-badge {
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: var(--brand);
            border: 2px solid #fff;
            border-radius: 50%;
            font-size: 0.78rem;
            margin-left: -6px;
        }

        .reaction-badge:first-child {
            margin-left: 0;
        }

        .comment-drawer {
            display: none;
            border-top: 1px solid var(--line);
            background: linear-gradient(180deg, #fbfdff, #f7fafc);
            padding: 1rem;
        }

        .comment-drawer.is-open {
            display: block;
        }

        .comment-input {
            min-height: 44px;
            resize: vertical;
            border-radius: 8px;
        }

        .comment-preview {
            display: none;
            color: var(--ink);
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 0.75rem;
            margin-bottom: 0.75rem;
            white-space: pre-line;
        }

        .comment-preview.has-comment {
            display: block;
        }

        .share-status {
            min-height: 1.2rem;
            color: var(--brand);
            font-size: 0.78rem;
            font-weight: 700;
        }

        .feed-nav-item {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            color: var(--ink);
            border-radius: 8px;
            padding: 0.75rem;
            text-decoration: none;
            font-weight: 700;
        }

        .feed-nav-item:hover,
        .feed-nav-item:focus {
            color: var(--brand);
            background: rgba(47, 111, 237, 0.08);
            transform: translateX(2px);
        }

        .composer-panel {
            position: relative;
            overflow: hidden;
        }

        .composer-panel::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 5px;
            background: linear-gradient(90deg, var(--brand), var(--accent), var(--warm));
        }

        .newsletter-panel {
            background: linear-gradient(135deg, #111827, #1e3a8a);
            color: #fff;
        }

        .footer {
            color: #9ca3af;
            background: #0b1120;
        }

        @media (max-width: 991.98px) {
            .hero-shell {
                padding: 4rem 0 3rem;
            }

            .code-window {
                min-height: auto;
            }

            .feed-layout {
                grid-template-columns: minmax(0, 1fr);
            }

            .feed-sidebar {
                position: static;
            }

            .feed-sidebar-right {
                display: none;
            }

            .profile-panel {
                position: static;
            }
        }

        @media (max-width: 575.98px) {
            .container {
                padding-left: 0.85rem;
                padding-right: 0.85rem;
            }

            .feed-card,
            .feed-panel {
                border-radius: 8px;
            }

            .feed-image {
                max-height: 380px;
            }

            .feed-action {
                font-size: 0.88rem;
                padding-left: 0.35rem;
                padding-right: 0.35rem;
            }

            .reaction-strip {
                align-items: flex-start;
                flex-direction: column;
            }

            .hero-title {
                font-size: 1.8rem;
            }

            .smart-post-media {
                height: 132px;
            }

            .profile-post-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        /* Framer-Motion style fade-in / slide-up animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.96);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Classes to trigger animations */
        .animate-fade-in-up {
            opacity: 0;
            animation: fadeInUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-fade-in {
            opacity: 0;
            animation: fadeIn 0.9s ease forwards;
        }

        .animate-scale-in {
            opacity: 0;
            animation: scaleIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        /* Stagger helper delay classes */
        .delay-100 { animation-delay: 100ms; }
        .delay-200 { animation-delay: 200ms; }
        .delay-300 { animation-delay: 300ms; }
        .delay-400 { animation-delay: 400ms; }

        /* Apply modern transitions & hover effects to cards and buttons */
        .feed-card, .feature-card, .article-card, .hero-panel, .newsletter-panel {
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }
        
        .feed-card:hover, .feature-card:hover, .article-card:hover {
            transform: translateY(-6px) scale(1.008) !important;
            box-shadow: 0 20px 38px rgba(17, 24, 39, 0.08) !important;
            border-color: rgba(47, 111, 237, 0.28) !important;
        }

        .btn-brand, .btn-outline-brand, .btn-light, .btn-outline-light {
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
        }

        .btn-brand:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(47, 111, 237, 0.35) !important;
        }

        .btn-outline-brand:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06) !important;
        }

        .navbar-nav .nav-link {
            transition: all 0.25s ease;
        }

        /* ── Post Detail Page ── */

        .detail-page {
            min-height: 75vh;
        }

        .detail-layout {
            display: grid;
            grid-template-columns: minmax(190px, 236px) minmax(0, 780px) minmax(220px, 292px);
            gap: 1.5rem;
            align-items: start;
        }

        .detail-sidebar {
            position: sticky;
            top: 5.5rem;
        }

        .detail-sidebar-right {
            position: sticky;
            top: 5.5rem;
        }

        .detail-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: box-shadow 0.3s ease;
        }

        .detail-card:hover {
            box-shadow: var(--shadow-md);
        }

        .detail-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.5rem 1.5rem 0;
        }

        .detail-author-photo {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            flex: 0 0 48px;
        }

        .detail-author-fallback {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            font-weight: 800;
            font-size: 1.1rem;
            flex: 0 0 48px;
        }

        .detail-title {
            font-size: clamp(1.6rem, 3.2vw, 2.2rem);
            line-height: 1.15;
            margin: 1rem 1.5rem 0;
            color: var(--ink);
        }

        .detail-image-wrapper {
            margin: 1.25rem 0 0;
            background: linear-gradient(135deg, rgba(47, 111, 237, 0.06), rgba(15, 159, 143, 0.06)), #f5f8fb;
        }

        .detail-image {
            width: 100%;
            max-height: 480px;
            object-fit: cover;
            display: block;
        }

        .detail-content {
            padding: 1.5rem;
            font-size: 0.96rem;
            line-height: 1.8;
            color: #2d3748;
        }

        .detail-content p {
            margin-bottom: 1.15rem;
        }

        .detail-content p:last-child {
            margin-bottom: 0;
        }

        .detail-content img {
            max-width: 100%;
            border-radius: 8px;
            margin: 1rem 0;
        }

        .detail-content blockquote {
            border-left: 4px solid var(--brand);
            padding-left: 1rem;
            margin: 1.25rem 0;
            color: var(--muted);
            font-style: italic;
        }

        .detail-content pre {
            background: #0f172a;
            color: #dbeafe;
            border-radius: 8px;
            padding: 1rem;
            overflow-x: auto;
            font-size: 0.84rem;
            line-height: 1.6;
        }

        .detail-content code {
            font-size: 0.84em;
        }

        .detail-content ul,
        .detail-content ol {
            padding-left: 1.4rem;
            margin-bottom: 1.15rem;
        }

        .detail-content h1,
        .detail-content h2,
        .detail-content h3,
        .detail-content h4 {
            margin-top: 1.75rem;
            margin-bottom: 0.65rem;
        }

        .detail-stats {
            border-top: 1px solid var(--line);
            padding: 0.85rem 1.5rem;
            color: var(--muted);
            font-size: 0.86rem;
        }

        .detail-actions {
            border-top: 1px solid var(--line);
            padding: 0.5rem 1.5rem;
        }

        .breadcrumb {
            background: rgba(255,255,255,0.6);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            border: 1px solid var(--line);
        }

        .breadcrumb a {
            color: var(--brand);
        }

        .breadcrumb .active {
            color: var(--muted);
        }

        /* Better card hover — entire card clickable */
        .smart-post-card {
            transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
        }

        .smart-post-card:hover {
            transform: translateY(-6px) scale(1.008);
            box-shadow: 0 20px 40px rgba(17, 24, 39, 0.1);
            border-color: rgba(47, 111, 237, 0.3);
        }

        @media (max-width: 991.98px) {
            .detail-layout {
                grid-template-columns: minmax(0, 1fr);
            }
            .detail-sidebar {
                position: static;
            }
            .detail-sidebar-right {
                display: none;
            }
            .detail-header {
                padding: 1.25rem 1.25rem 0;
            }
            .detail-title {
                margin: 1rem 1.25rem 0;
                font-size: 1.4rem;
            }
            .detail-content {
                padding: 1.25rem;
            }
            .detail-stats {
                padding: 0.75rem 1.25rem;
            }
            .detail-actions {
                padding: 0.5rem 1.25rem;
            }
        }
    </style>
</head>

