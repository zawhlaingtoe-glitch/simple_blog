<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">

    <style>
     :root {
            --ink: #111111;
            --muted: #555555;
            --line: #e0e0e0;
            --soft: #f5f5f5;
            --brand: #10b981;
            --brand-dark: #059669;
            --accent: #10b981;
            --warm: #f59e0b;
            --danger: #dc2626;
            --panel: #ffffff;
            --panel-soft: rgba(255, 255, 255, 0.85);
            --shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 22px 55px rgba(0, 0, 0, 0.09);
            --nav-bg: rgba(255, 255, 255, 0.9);
            --body-bg-from: #ffffff;
            --body-bg-to: #f5f5f5;
            --card-bg: #ffffff;
            --card-bg-soft: rgba(255, 255, 255, 0.9);
            --summernote-bg: #fff;
            --summernote-toolbar: #f8f8f8;
            --reaction-strip-bg: linear-gradient(180deg, #fafafa, #f5f5f5);
            --input-group-bg: #fff;
            --auth-card-bg: #fff;
            --auth-bg: #fafafa;
            --tag-bg: rgba(16, 185, 129, 0.1);
            --tag-border: rgba(16, 185, 129, 0.2);
            --tag-color: #059669;
            --profile-card-bg: #111111;
            --footer-bg: #111111;
            --footer-text: #999999;
            --code-bg: #111111;
            --code-color: #e0e0e0;
            --feed-image-bg: #f0f0f0;
            --feed-image-empty-bg: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(16, 185, 129, 0.05)), #f5f5f5;
            --breadcrumb-bg: rgba(255, 255, 255, 0.7);
            --detail-content-color: #333333;
            --placeholder-gradient: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(16, 185, 129, 0.06)), #f5f5f5;
            --dropdown-bg: #fff;
            --dropdown-border: rgba(0, 0, 0, 0.08);
            --dropdown-hover-bg: rgba(16, 185, 129, 0.08);
            --alert-bg: #fff;
            --modal-bg: #fff;
        }
        
        [data-theme="dark"] {
            --ink: #ffffff;
            --muted: #aaaaaa;
            --line: #2a2a2a;
            --soft: #1a1a1a;
            --brand: #34d399;
            --brand-dark: #10b981;
            --accent: #34d399;
            --warm: #fbbf24;
            --danger: #f87171;
            --panel: #1a1a1a;
            --panel-soft: rgba(26, 26, 26, 0.95);
            --shadow-sm: 0 10px 28px rgba(0, 0, 0, 0.4);
            --shadow-md: 0 22px 55px rgba(0, 0, 0, 0.5);
            --nav-bg: rgba(0, 0, 0, 0.92);
            --body-bg-from: #000000;
            --body-bg-to: #111111;
            --card-bg: #1a1a1a;
            --card-bg-soft: rgba(26, 26, 26, 0.95);
            --summernote-bg: #1a1a1a;
            --summernote-toolbar: #222222;
            --reaction-strip-bg: linear-gradient(180deg, #1a1a1a, #111111);
            --input-group-bg: #1a1a1a;
            --auth-card-bg: #1a1a1a;
            --auth-bg: #000000;
            --tag-bg: rgba(52, 211, 153, 0.12);
            --tag-border: rgba(52, 211, 153, 0.25);
            --tag-color: #34d399;
            --profile-card-bg: linear-gradient(135deg, #000000, #0a2e1f);
            --footer-bg: #000000;
            --footer-text: #777777;
            --code-bg: #0a0a0a;
            --code-color: #e0e0e0;
            --feed-image-bg: #1a1a1a;
            --feed-image-empty-bg: linear-gradient(135deg, rgba(52, 211, 153, 0.1), rgba(16, 185, 129, 0.06)), #111111;
            --breadcrumb-bg: rgba(26, 26, 26, 0.8);
            --detail-content-color: #e0e0e0;
            --placeholder-gradient: linear-gradient(135deg, rgba(52, 211, 153, 0.1), rgba(16, 185, 129, 0.06)), #111111;
            --dropdown-bg: #1a1a1a;
            --dropdown-border: rgba(255, 255, 255, 0.08);
            --dropdown-hover-bg: rgba(52, 211, 153, 0.1);
            --alert-bg: #1a1a1a;
            --modal-bg: #1a1a1a;
        }
        
        * {
            letter-spacing: 0;
        }
        /* Smooth theme transition */
        
        body,
        .navbar,
        .feed-card,
        .feed-panel,
        .hero-panel,
        .article-card,
        .detail-card,
        .auth-card,
        .auth-benefit,
        .auth-stat,
        .feature-card,
        .newsletter-panel,
        .btn-outline-brand,
        .btn-outline-light,
        .form-control,
        .form-select,
        .input-group-text,
        .input-group,
        .note-editor.note-frame,
        .note-editor .note-toolbar,
        .note-editor .note-statusbar,
        .note-editor .note-editable,
        .code-window,
        .badge,
        .tag,
        .breadcrumb,
        .page-link,
        .dropdown-menu,
        .dropdown-item,
        .alert,
        .modal-content,
        .comment-preview,
        .reply-item,
        .profile-summary-card,
        .smart-post-card,
        .profile-post-card,
        .feed-sidebar .feed-panel {
            transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
        }
        
        body {
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            font-size: 0.82rem;
            color: var(--ink);
            background: radial-gradient(circle at 8% 0%, rgba(16, 185, 129, 0.12), transparent 28rem), radial-gradient(circle at 92% 12%, rgba(15, 159, 143, 0.1), transparent 24rem), linear-gradient(180deg, var(--body-bg-from) 0%, var(--body-bg-to) 100%);
        }
        
        .navbar {
            background: var(--nav-bg);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(18px);
            box-shadow: 0 8px 26px rgba(15, 23, 42, 0.04);
        }
        
        .navbar-brand {
            color: var(--ink);
            font-size: 0.9rem;
            letter-spacing: 0;
        }
        
        .navbar-brand span {
            color: var(--accent);
        }
        
        .navbar-toggler {
            border: 1px solid var(--line);
            box-shadow: none;
        }
        
        .navbar-toggler:focus {
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.16);
        }
        
        .nav-link {
            color: #4b5563;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.52rem 0.72rem !important;
            border-radius: 8px;
        }
        
        .nav-link:hover,
        .nav-link:focus {
            color: var(--brand);
            background: rgba(16, 185, 129, 0.08);
        }
        
        .nav-link i {
            color: var(--brand);
        }
        
        .btn-brand {
            color: #fff;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            border: 1px solid var(--brand);
            border-radius: 8px;
            font-weight: 700;
            padding: 0.6rem 0.82rem;
            box-shadow: 0 10px 24px rgba(16, 185, 129, 0.22);
        }
        
        .btn-brand:hover,
        .btn-brand:focus {
            color: #fff;
            background: linear-gradient(135deg, var(--brand-dark), #047857);
            border-color: var(--brand-dark);
            transform: translateY(-1px);
        }
        
        .btn-outline-brand {
            color: var(--ink);
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid var(--line);
            border-radius: 8px;
            font-weight: 700;
            padding: 0.6rem 0.82rem;
        }
        
        .btn-outline-brand:hover,
        .btn-outline-brand:focus {
            color: var(--brand);
            border-color: rgba(16, 185, 129, 0.38);
            background: rgba(16, 185, 129, 0.06);
        }
        
        .section-label {
            color: var(--accent);
            font-size: 0.68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        
        .hero-shell {
            padding: 2.5rem 0 1.5rem;
        }
        
        .hero-title {
            max-width: 760px;
            font-size: clamp(1.5rem, 3.5vw, 2.5rem);
            font-weight: 800;
            line-height: 1.04;
        }
        
        .hero-copy {
            max-width: 620px;
            color: var(--muted);
            font-size: 0.82rem;
            line-height: 1.65;
        }
        
        .hero-panel,
        .feature-card,
        .article-card,
        .newsletter-panel {
            background: var(--panel-soft);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(12px);
        }
        
        .hero-panel {
            overflow: hidden;
        }
        
        .code-window {
            background: var(--code-bg);
            color: var(--code-color);
            min-height: 220px;
        }
        
        .window-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ef4444;
        }
        
        .window-dot:nth-child(2) {
            background: #f59e0b;
        }
        
        .window-dot:nth-child(3) {
            background: #22c55e;
        }
        
        .code-line {
            color: #6ee7b7;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.8rem;
            line-height: 1.75;
            white-space: pre-wrap;
        }
        
        .metric-box {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .feature-card,
        .article-card {
            height: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        
        .feature-card:hover,
        .article-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }
        
        .icon-box {
            display: inline-flex;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            color: var(--brand);
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(15, 159, 143, 0.12));
            border-radius: 8px;
        }
        
        .auth-page {
            position: relative;
            overflow: hidden;
        }
        
        .auth-copy-stack {
            max-width: 620px;
        }
        
        .auth-card {
            position: relative;
            background: var(--auth-card-bg);
            border: 1px solid var(--line);
            border-top: 4px solid var(--accent);
            border-radius: 8px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
            overflow: hidden;
        }
        
        .auth-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 108px;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(15, 159, 143, 0.1)), var(--auth-bg);
            pointer-events: none;
        }
        
        .auth-card>* {
            position: relative;
            z-index: 1;
        }
        
        .auth-card .input-group {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--input-group-bg);
            overflow: hidden;
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
        }
        
        .auth-card .input-group:focus-within {
            border-color: rgba(16, 185, 129, 0.55);
            box-shadow: 0 0 0 0.22rem rgba(16, 185, 129, 0.12);
        }
        
        .auth-card .input-group-text,
        .auth-card .form-control {
            border: 0;
            box-shadow: none;
            background: var(--input-group-bg);
        }
        
        .auth-card .form-control:focus {
            box-shadow: none;
        }
        
        .auth-card .input-group-text {
            min-width: 46px;
            justify-content: center;
            background: var(--input-group-bg);
        }
        
        .auth-benefit {
            display: flex;
            gap: 0.85rem;
            align-items: flex-start;
            height: 100%;
            background: var(--panel-soft);
            border: 1px solid var(--line);
            border-left: 4px solid rgba(15, 159, 143, 0.62);
            border-radius: 8px;
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
        }
        
        .auth-benefit .icon-box {
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
        }
        
        .auth-stat-strip {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
            max-width: 560px;
        }
        
        .auth-stat {
            padding: 0.85rem;
            background: var(--panel-soft);
            border: 1px solid var(--line);
            border-radius: 8px;
        }
        
        .auth-stat strong {
            display: block;
            color: var(--ink);
            font-size: 1.05rem;
            line-height: 1.1;
        }
        
        .auth-stat span {
            color: var(--muted);
            font-size: 0.72rem;
            font-weight: 700;
        }
        
        .form-control,
        .form-select,
        .input-group-text {
            border-color: var(--line);
            border-radius: 8px;
        }
        
        .form-control:focus,
        .form-select:focus {
            border-color: rgba(16, 185, 129, 0.58);
            box-shadow: 0 0 0 0.22rem rgba(16, 185, 129, 0.14);
        }
        
        textarea.form-control {
            line-height: 1.7;
        }
        
        h1,
        .h1 {
            font-size: 1.8rem;
        }
        
        h2,
        .h2 {
            font-size: 1.42rem;
        }
        
        h3,
        .h3 {
            font-size: 1.18rem;
        }
        
        h4,
        .h4 {
            font-size: 1rem;
        }
        
        h5,
        .h5 {
            font-size: 0.94rem;
        }
        
        .form-label {
            font-size: 0.82rem;
            margin-bottom: 0.35rem;
        }
        
        .form-control,
        .form-select {
            font-size: 0.86rem;
        }
        
        .article-meta {
            color: var(--muted);
            font-size: 0.76rem;
            font-weight: 600;
        }
        
        .article-card a {
            color: var(--ink);
            text-decoration: none;
        }
        
        .article-card a:hover {
            color: var(--brand);
        }
        
        .tag {
            display: inline-flex;
            align-items: center;
            color: var(--tag-color);
            background: var(--tag-bg);
            border: 1px solid var(--tag-border);
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 700;
            max-width: 100%;
            padding: 0.24rem 0.52rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-decoration: none;
        }
        
        .tag:hover {
            color: var(--tag-color);
            opacity: 0.85;
        }
        /* ── Tag pills for post cards ── */
        
        .tag-pill {
            display: inline-flex;
            align-items: center;
            color: var(--brand);
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.16);
            border-radius: 999px;
            font-size: 0.68rem;
            font-weight: 700;
            padding: 0.2rem 0.5rem;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        
        [data-theme="dark"] .tag-pill {
            background: rgba(52, 211, 153, 0.12);
            border-color: rgba(52, 211, 153, 0.22);
        }
        
        .tag-pill:hover {
            color: var(--brand-dark);
            background: rgba(16, 185, 129, 0.14);
        }
        /* ── External share popover ── */
        
        [data-external-share-toggle] {
            position: relative;
            overflow: hidden;
        }
        
        [data-external-share-toggle] i {
            background: linear-gradient(135deg, #6366f1, #06b6d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        [data-external-share-toggle] span {
            background: linear-gradient(135deg, #6366f1, #06b6d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        [data-external-share-toggle]:hover {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.1), rgba(6, 182, 212, 0.1)) !important;
        }
        
        .share-popover {
            position: absolute;
            bottom: calc(100% + 8px);
            right: 0;
            left: auto;
            z-index: 200;
            display: block;
            pointer-events: none;
            opacity: 0;
            transform: translateY(10px) scale(0.95);
            transform-origin: bottom right;
            transition: opacity 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
            background: var(--dropdown-bg, #fff);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(99, 102, 241, 0.18);
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(15, 23, 42, 0.18), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
            padding: 0.55rem;
            min-width: 195px;
        }
        
        .share-popover::before {
            content: '';
            position: absolute;
            bottom: -6px;
            right: 18px;
            width: 12px;
            height: 12px;
            background: var(--dropdown-bg, #fff);
            border-right: 1px solid rgba(99, 102, 241, 0.18);
            border-bottom: 1px solid rgba(99, 102, 241, 0.18);
            transform: rotate(45deg);
        }
        
        .share-popover .share-header {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #94a3b8;
            padding: 0.25rem 0.6rem 0.4rem;
            border-bottom: 1px solid rgba(148, 163, 184, 0.15);
            margin-bottom: 0.35rem;
        }
        
        .share-popover.is-open {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }
        
        .share-popover .share-option {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.5rem 0.7rem;
            border-radius: 9px;
            cursor: pointer;
            color: var(--ink);
            text-decoration: none;
            font-size: 0.83rem;
            font-weight: 600;
            transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
            position: relative;
        }
        
        .share-popover .share-option i {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            font-size: 1rem;
            flex-shrink: 0;
            transition: transform 0.2s ease;
        }
        
        .share-popover .share-option:hover {
            transform: translateX(2px);
        }
        
        .share-popover .share-option:hover i {
            transform: scale(1.15);
        }
        
        .share-option-facebook {
            color: #1877f2;
        }
        
        .share-option-facebook i {
            background: rgba(24, 119, 242, 0.12);
            color: #1877f2;
        }
        
        .share-option-facebook:hover {
            background: rgba(24, 119, 242, 0.08);
            box-shadow: 0 2px 12px rgba(24, 119, 242, 0.15);
        }
        
        .share-option-twitter {
            color: #000;
        }
        
        .share-option-twitter i {
            background: rgba(0, 0, 0, 0.08);
            color: #000;
        }
        
        .share-option-twitter:hover {
            background: rgba(0, 0, 0, 0.06);
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
        }
        
        .share-option-linkedin {
            color: #0a66c2;
        }
        
        .share-option-linkedin i {
            background: rgba(10, 102, 194, 0.12);
            color: #0a66c2;
        }
        
        .share-option-linkedin:hover {
            background: rgba(10, 102, 194, 0.08);
            box-shadow: 0 2px 12px rgba(10, 102, 194, 0.15);
        }
        
        .share-option-copy {
            color: #6366f1;
        }
        
        .share-option-copy i {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(6, 182, 212, 0.12));
            color: #6366f1;
        }
        
        .share-option-copy:hover {
            background: rgba(99, 102, 241, 0.08);
            box-shadow: 0 2px 12px rgba(99, 102, 241, 0.15);
        }
        /* ── Live Search Widget ── */
        
        .live-search-wrapper {
            position: relative;
        }
        
        .live-search-bar {
            display: flex;
            align-items: center;
            gap: 0;
            background: var(--card-bg, #fff);
            border: 1.5px solid var(--line, #e2e8f0);
            border-radius: 12px;
            padding: 0 0.5rem 0 0.85rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
        }
        
        .live-search-bar:focus-within {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15), 0 2px 8px rgba(15, 23, 42, 0.06);
        }
        
        .live-search-icon {
            color: #94a3b8;
            font-size: 0.95rem;
            flex-shrink: 0;
            pointer-events: none;
            margin-right: 0.5rem;
            transition: color 0.2s ease;
        }
        
        .live-search-bar:focus-within .live-search-icon {
            color: #6366f1;
        }
        
        .live-search-input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.88rem;
            color: var(--ink, #1e293b);
            padding: 0.7rem 0;
            min-width: 0;
        }
        
        .live-search-input::-webkit-search-cancel-button {
            display: none;
        }
        
        .live-search-clear {
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 0.3rem 0.4rem;
            border-radius: 6px;
            font-size: 0.75rem;
            transition: color 0.15s, background 0.15s;
            flex-shrink: 0;
        }
        
