    .medium-action-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding: 0.55rem 0;
        margin-bottom: 0;
    }
    /* ── Hashnode‑Inspired Comments ── */
    .hn-comments-section {
        padding: 1.25rem 0 0;
        display: none;
    }
    .hn-comments-section.is-open {
        display: block;
    }
    .hn-comment-input-wrap {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }
    .hn-comment-input-wrap .hn-author-avatar,
    .hn-comment-input-wrap .hn-author-fallback {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
    }
    .hn-comment-box {
        flex: 1;
    }
    .hn-comment-box textarea {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 0.7rem 0.9rem;
        font-size: 0.88rem;
        font-family: inherit;
        resize: vertical;
        min-height: 44px;
        background: var(--card-bg);
        color: var(--ink);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .hn-comment-box textarea:focus {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(47, 111, 237, 0.1);
    }
    .hn-comment-box .hn-comment-submit {
        margin-top: 0.5rem;
    }
    .hn-comment-thread {
        margin-bottom: 0.85rem;
    }
    .hn-comment {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        padding: 0.9rem;
        background: var(--soft);
        border-radius: 10px;
        margin-bottom: 0.4rem;
    }
    .hn-comment .hn-author-fallback,
    .hn-comment .hn-author-avatar {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        font-size: 0.75rem;
    }
    .hn-comment-body {
        flex: 1;
        min-width: 0;
    }
    .hn-comment-author {
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--ink);
    }
    .hn-comment-text {
        font-size: 0.88rem;
        line-height: 1.55;
        color: var(--ink);
        white-space: pre-line;
        margin: 0.1rem 0 0.25rem;
    }
    .hn-reply-btn {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--muted);
        border: none;
        background: none;
        cursor: pointer;
        padding: 0;
    }
    .hn-reply-btn:hover {
        color: var(--brand);
    }
    .hn-reply-thread {
        padding-left: 2.8rem;
        margin-top: 0.4rem;
    }
    .hn-reply-thread .hn-comment {
        background: transparent;
        border-left: 2px solid var(--line);
        border-radius: 0;
    }
    /* ── Hashnode page header ── */
    .hn-page-header {
        margin-bottom: 1.5rem;
    }
    .hn-page-header h1 {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 0.2rem;
    }
    .hn-page-header p {
        color: var(--muted);
        font-size: 0.9rem;
    }
    .hn-breadcrumb {
        font-size: 0.82rem;
        color: var(--muted);
        margin-bottom: 1rem;
    }
    .hn-breadcrumb a {
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
    }
    .hn-breadcrumb a:hover {
        color: var(--brand);
    }
    .hn-breadcrumb .sep {
        margin: 0 0.4rem;
        opacity: 0.4;
    }
    .hn-breadcrumb .current {
        color: var(--ink);
        font-weight: 600;
    }
    /* ── Hashnode pagination ── */
    .hn-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.35rem;
        margin-top: 2rem;
    }
    .hn-page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--card-bg);
        color: var(--ink);
        font-size: 0.84rem;
        font-weight: 600;
        text-decoration: none;
        padding: 0 0.5rem;
        transition: all 0.15s ease;
    }
    .hn-page-btn:hover {
        border-color: var(--brand);
        color: var(--brand);
    }
    .hn-page-btn.active {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
    }
    .hn-page-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
    }
    /* ── Hashnode empty state ── */
    .hn-empty {
        text-align: center;
        padding: 3rem 1.5rem;
    }
    .hn-empty i {
        font-size: 3rem;
        color: var(--muted);
        opacity: 0.3;
        margin-bottom: 1rem;
    }
    .hn-empty h4 {
        font-weight: 700;
        color: var(--ink);
    }
    .hn-empty p {
        color: var(--muted);
        margin-bottom: 1.25rem;
    }
    /* ── Hashnode private badge ── */
    .hn-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.12rem 0.5rem;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.12);
        color: #b45309;
    }
    [data-theme="dark"] .hn-badge {
        background: rgba(251, 191, 36, 0.15);
        color: #fbbf24;
    }
    /* ── Hashnode search refine ── */
    .hn-search-bar {
        display: flex;
        align-items: center;
        gap: 0;
        background: var(--card-bg);
        border: 1.5px solid var(--line);
        border-radius: 10px;
        padding: 0 0.5rem 0 0.85rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .hn-search-bar:focus-within {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(47, 111, 237, 0.1);
    }
    .hn-search-bar i {
        color: var(--muted);
        font-size: 0.95rem;
        margin-right: 0.5rem;
    }
    .hn-search-bar input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.88rem;
        color: var(--ink);
        padding: 0.65rem 0;
    }
    .hn-search-bar button {
        background: var(--brand);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.4rem 1rem;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
    }
    .hn-search-bar button:hover {
        opacity: 0.9;
    }
    @media (max-width: 991.98px) {
        .medium-detail-layout {
            display: block;
            max-width: 760px;
        }
        
        .hn-card-image-wrap {
            height: 180px;
        }
        
        .hn-card-body {
            padding: 1rem 1.25rem 0.75rem;
        }
        
        .hn-card-footer {
            padding: 0.6rem 1.25rem 0.85rem;
        }
        
        .hn-article-header {
            padding: 0.75rem 0 0;
        }
        
        .hn-article-body {
            padding: 0;
        }
        
        .hn-article-cover {
            max-height: 420px;
        }
        
        .hn-article-cover-empty {
            height: 220px;
        }
    }
    @media (max-width: 575.98px) {
        .medium-breadcrumb {
            margin-bottom: 0.75rem;
        }
        
        .medium-breadcrumb .current {
            max-width: 180px;
        }
        
        .medium-author-row {
            align-items: flex-start;
            gap: 0.65rem;
        }
        
        .medium-action-bar {
            align-items: flex-start;
            flex-direction: column;
            gap: 0.65rem;
            padding: 0.7rem 0;
        }
        
        .hn-article-actions {
            width: 100%;
            justify-content: flex-start;
            overflow-x: auto;
            padding-bottom: 0.1rem;
        }
        
        .hn-card-image-wrap {
            height: 160px;
        }
        
        .hn-card-title {
            font-size: 1.1rem;
        }
        
        .hn-article-title {
            font-size: 2.2rem;
        }
        
        .hn-article-body {
            font-size: 1.08rem;
            line-height: 1.78;
            padding: 0;
        }
        
        .hn-article-header {
            padding: 0.5rem 0 0;
        }
        
        .hn-comments-section {
            padding: 1rem 0 0;
        }
        
        .hn-reply-thread {
            padding-left: 1.5rem;
        }
    }
    /* ── Dark mode overrides for hardcoded colors ── */
    [data-theme="dark"] .navbar-toggler-icon {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.7)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
    }
    [data-theme="dark"] .text-muted {
        color: var(--muted) !important;
    }
    [data-theme="dark"] .text-dark {
        color: var(--ink) !important;
    }
    [data-theme="dark"] .bg-white {
        background-color: var(--card-bg) !important;
    }
    [data-theme="dark"] .bg-light {
        background-color: var(--soft) !important;
    }
    [data-theme="dark"] .border-light {
        border-color: var(--line) !important;
    }
    [data-theme="dark"] .btn-light {
        color: var(--ink);
        background-color: var(--soft);
        border-color: var(--line);
    }
    [data-theme="dark"] .btn-light:hover {
        background-color: var(--panel);
        border-color: var(--muted);
    }
    [data-theme="dark"] .btn-outline-light {
        color: var(--ink);
        border-color: var(--line);
    }
    [data-theme="dark"] .btn-outline-light:hover {
        background-color: var(--panel);
        border-color: var(--muted);
    }
    [data-theme="dark"] .alert-light {
        color: var(--ink);
        background-color: var(--soft);
        border-color: var(--line);
    }
    [data-theme="dark"] .list-group-item {
        background-color: var(--card-bg);
        border-color: var(--line);
        color: var(--ink);
    }
    [data-theme="dark"] .modal-content {
        background-color: var(--modal-bg);
        border-color: var(--line);
    }
    [data-theme="dark"] .modal-header,
    [data-theme="dark"] .modal-footer {
        border-color: var(--line);
    }
    /* Dark theme overrides for hardcoded colors */
    [data-theme="dark"] .share-option-twitter {
        color: #fff;
    }
    [data-theme="dark"] .share-option-twitter i {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }
    [data-theme="dark"] .share-option-twitter:hover {
        background: rgba(255, 255, 255, 0.08);
    }
    [data-theme="dark"] .smart-post-avatar,
    [data-theme="dark"] .hn-author-avatar {
        background: var(--card-bg);
    }
    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
        background-color: var(--input-group-bg);
        border-color: var(--line);
        color: var(--ink);
    }
    [data-theme="dark"] .form-control:focus,
    [data-theme="dark"] .form-select:focus {
        background-color: var(--input-group-bg);
        border-color: var(--brand);
        color: var(--ink);
    }
    [data-theme="dark"] .input-group-text {
        background-color: var(--soft);
        border-color: var(--line);
        color: var(--muted);
    }
    [data-theme="dark"] .dropdown-item {
        color: var(--ink);
    }
    [data-theme="dark"] .dropdown-item:hover {
        background-color: var(--dropdown-hover-bg);
        color: var(--brand);
    }
    [data-theme="dark"] .badge.bg-light {
        background-color: var(--soft) !important;
        color: var(--muted) !important;
    }
    [data-theme="dark"] .breadcrumb {
        background-color: var(--breadcrumb-bg);
    }
    [data-theme="dark"] .breadcrumb-item a {
        color: var(--brand);
    }
    [data-theme="dark"] .breadcrumb-item.active {
        color: var(--muted);
    }
    [data-theme="dark"] .nav-link {
        color: var(--muted) !important;
    }
    [data-theme="dark"] .nav-link:hover {
        color: var(--ink) !important;
    }
    [data-theme="dark"] .navbar-brand {
        color: var(--ink) !important;
    }
    [data-theme="dark"] .navbar-brand span {
        color: var(--accent) !important;
    }
    [data-theme="dark"] .btn-outline-brand {
        color: var(--ink);
        background: transparent;
        border-color: var(--line);
    }
    [data-theme="dark"] .btn-outline-brand:hover,
    [data-theme="dark"] .btn-outline-brand:focus {
        color: var(--brand);
        background: rgba(16, 185, 129, 0.1);
        border-color: var(--brand);
    }
    [data-theme="dark"] .hn-article-card {
        background: transparent;
        border-color: transparent;
    }
    [data-theme="dark"] .hn-sidebar-card {
        background: var(--card-bg);
        border-color: var(--line);
    }
    [data-theme="dark"] .hn-nav-item {
        color: var(--muted);
    }
    [data-theme="dark"] .hn-nav-item:hover {
        color: var(--brand);
        background: var(--dropdown-hover-bg);
    }
    [data-theme="dark"] .hn-comment-input-wrap {
        border-color: var(--line);
    }
    [data-theme="dark"] .hn-comment-box textarea {
        background: var(--input-group-bg);
        color: var(--ink);
        border-color: var(--line);
    }
    [data-theme="dark"] .hn-comment-box textarea:focus {
        border-color: var(--brand);
    }
    [data-theme="dark"] .hn-action-btn {
        color: var(--muted);
    }
    [data-theme="dark"] .hn-action-btn:hover {
        color: var(--brand);
        background: var(--dropdown-hover-bg);
    }
    [data-theme="dark"] .hn-action-btn.is-active {
        color: var(--brand);
    }
    [data-theme="dark"] .hn-tag {
        background: var(--tag-bg);
        border-color: var(--tag-border);
        color: var(--tag-color);
    }
    [data-theme="dark"] .text-primary {
        color: var(--accent) !important;
    }
    [data-theme="dark"] .btn-primary {
        background: linear-gradient(135deg, var(--brand), var(--accent));
        border-color: var(--brand);
    }
    [data-theme="dark"] .btn-primary:hover {
        background: linear-gradient(135deg, var(--brand-dark), #047857);
        border-color: var(--brand-dark);
    }
    /* Account Modal */
    .account-modal {
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-md);
        background: var(--modal-bg);
    }
    .account-modal-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem 1rem 1rem;
        background: var(--soft);
        border-bottom: 1px solid var(--line);
    }
    .account-modal-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--brand);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }
    .account-modal-avatar-placeholder {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--soft);
        border: 3px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--muted);
    }
    .account-modal-menu {
        padding: 0.5rem 0;
    }
    .account-modal-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 1.25rem;
        color: var(--ink);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: background 0.15s ease;
    }
    .account-modal-item:hover {
        background: var(--dropdown-hover-bg);
        color: var(--brand);
    }
    .account-modal-item.text-danger:hover {
        background: rgba(220, 38, 38, 0.08);
        color: var(--danger) !important;
    }
    .account-modal-item i {
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
    }
    .account-modal-divider {
        height: 1px;
        background: var(--line);
        margin: 0.35rem 0;
    }
    .profile-trigger {
        display: flex;
        align-items: center;
    }
    [data-theme="dark"] .btn-close {
        filter: invert(1);
    }
    [data-theme="dark"] .text-info-emphasis {
        color: var(--accent) !important;
    }
    [data-theme="dark"] .bg-info-subtle {
        background-color: rgba(45, 212, 191, 0.12) !important;
    }
    [data-theme="dark"] .border-info-subtle {
        border-color: rgba(45, 212, 191, 0.2) !important;
    }
    [data-theme="dark"] .text-primary {
        color: var(--brand) !important;
    }
    [data-theme="dark"] .text-white-50 {
        color: rgba(255, 255, 255, 0.55) !important;
    }
    </style>

    <script>
        // ── Dark mode initialization (run before render to prevent FOUC) ──
        (function() {
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (stored === 'dark' || (!stored && prefersDark)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();

        // ── Reading time helper ──
        window.readingTime = function(content) {
            if (!content) return '1 min read';
            const text = content.replace(/<[^>]*>/g, '');
            const wordCount = text.split(/\s+/).filter(Boolean).length;
            const minutes = Math.max(1, Math.ceil(wordCount / 200));
            return minutes + ' min read';
        };
    </script>
</head>

<body>
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">TECH<span>BLOG</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house me-1"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/posts"><i class="bi bi-file-text me-1"></i>Posts</a>
                    </li>
                    <li class="nav-item mx-lg-2" style="min-width:180px;">
                        <form action="/posts/search" method="GET" class="d-flex" role="search">
                            <div class="input-group input-group-sm">
                                <input class="form-control border-end-0" type="search" name="q" placeholder="Search posts..." aria-label="Search" style="font-size:0.82rem;">
                                <button class="btn btn-outline-brand border-start-0" type="submit" style="border:1px solid var(--line);border-left:0;background:transparent;padding:0.28rem 0.6rem;">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>
                    </li>
                    <li class="nav-item">
                        <button id="darkModeToggle" class="nav-link" style="border:none;background:none;cursor:pointer;" aria-label="Toggle dark mode">
                            <i class="bi bi-moon-stars"></i>
                        </button>
                    </li>
                    <% if (locals.isLoggedIn && locals.currentUser) { %>
                        <li class="nav-item">
                            <button class="nav-link profile-trigger" data-bs-toggle="modal" data-bs-target="#accountModal" style="border:none;background:none;cursor:pointer;">
                                <% if (locals.currentUser.profile_photo) { %>
                                    <img src="/upload/<%= locals.currentUser.profile_photo %>" alt="<%= locals.currentUser.username %>" style="width: 26px; height: 26px; border-radius: 50%; object-fit: cover; margin-right: 5px; border: 2px solid var(--brand); vertical-align: middle;">
                                <% } else { %>
                                    <i class="bi bi-person-circle me-1"></i>
                                <% } %>
                                <%= locals.currentUser.username %>
                            </button>
                        </li>
                        <% } else { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/users/register"><i class="bi bi-person-plus me-1"></i>Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/users/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                            </li>
                            <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Account Modal -->
    <div class="modal fade" id="accountModal" tabindex="-1" aria-labelledby="accountModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 340px;">
            <div class="modal-content account-modal">
                <div class="modal-body p-0">
                    <div class="account-modal-header">
                        <% if (locals.currentUser && locals.currentUser.profile_photo) { %>
                            <img src="/upload/<%= locals.currentUser.profile_photo %>" alt="<%= locals.currentUser.username %>" class="account-modal-avatar">
                            <% } else { %>
                                <div class="account-modal-avatar-placeholder">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <% } %>
                                    <h6 class="mb-0 mt-2">
                                        <%= locals.currentUser ? locals.currentUser.username : '' %>
                                    </h6>
                                    <span class="text-muted small"><%= locals.currentUser ? locals.currentUser.email : '' %></span>
                    </div>
                    <div class="account-modal-menu">
                        <a href="/users/profile" class="account-modal-item">
                            <i class="bi bi-person"></i>
                            <span>My Profile</span>
                        </a>
                        <a href="/users/profile/edit" class="account-modal-item">
                            <i class="bi bi-pencil-square"></i>
                            <span>Edit Profile</span>
                        </a>
                        <div class="account-modal-divider"></div>
                        <a href="/users/logout" class="account-modal-item text-danger">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ── Dark mode toggle ──
        document.addEventListener('DOMContentLoaded', function() {
            const toggle = document.getElementById('darkModeToggle');
            const html = document.documentElement;
            if (!toggle) return;

            const updateIcon = () => {
                const isDark = html.getAttribute('data-theme') === 'dark';
                toggle.innerHTML = isDark ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon-stars"></i>';
                toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
            };

            updateIcon();

            toggle.addEventListener('click', () => {
                const isDark = html.getAttribute('data-theme') === 'dark';
                const newTheme = isDark ? 'light' : 'dark';
                html.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateIcon();
            });
        });
    </script>
