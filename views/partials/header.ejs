<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --ink: #17202a;
            --muted: #697386;
            --line: #e3e8ef;
            --soft: #f4f7fb;
            --brand: #2f6fed;
            --brand-dark: #2157bf;
            --accent: #0f9f8f;
            --warm: #f59e0b;
            --danger: #dc2626;
            --panel: #ffffff;
            --panel-soft: rgba(255, 255, 255, 0.78);
            --shadow-sm: 0 10px 28px rgba(17, 24, 39, 0.06);
            --shadow-md: 0 22px 55px rgba(17, 24, 39, 0.09);
        }

        * {
            letter-spacing: 0;
        }

        body {
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at 8% 0%, rgba(47, 111, 237, 0.12), transparent 28rem),
                radial-gradient(circle at 92% 12%, rgba(15, 159, 143, 0.1), transparent 24rem),
                linear-gradient(180deg, #fbfcff 0%, var(--soft) 100%);
        }

        .navbar {
            background: rgba(255, 255, 255, 0.84);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(18px);
            box-shadow: 0 8px 26px rgba(15, 23, 42, 0.04);
        }

        .navbar-brand {
            color: var(--ink);
            font-size: 1.05rem;
            letter-spacing: 0;
        }

        .navbar-brand span {
            color: var(--accent);
        }

        .navbar-toggler {
            border: 1px solid var(--line);
            box-shadow: none;
        }

        .navbar-toggler:focus {
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.16);
        }

        .nav-link {
            color: #4b5563;
            font-size: 0.94rem;
            font-weight: 600;
            padding: 0.65rem 0.9rem !important;
            border-radius: 8px;
        }

        .nav-link:hover,
        .nav-link:focus {
            color: var(--brand);
            background: rgba(47, 111, 237, 0.08);
        }

        .nav-link i {
            color: var(--brand);
        }

        .btn-brand {
            color: #fff;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            border: 1px solid var(--brand);
            border-radius: 8px;
            font-weight: 700;
            padding: 0.75rem 1rem;
            box-shadow: 0 10px 24px rgba(47, 111, 237, 0.22);
        }

        .btn-brand:hover,
        .btn-brand:focus {
            color: #fff;
            background: linear-gradient(135deg, var(--brand-dark), #0d8175);
            border-color: var(--brand-dark);
            transform: translateY(-1px);
        }

        .btn-outline-brand {
            color: var(--ink);
            background: rgba(255, 255, 255, 0.86);
            border: 1px solid var(--line);
            border-radius: 8px;
            font-weight: 700;
            padding: 0.75rem 1rem;
        }

        .btn-outline-brand:hover,
        .btn-outline-brand:focus {
            color: var(--brand);
            border-color: rgba(37, 99, 235, 0.38);
            background: rgba(37, 99, 235, 0.06);
        }

        .section-label {
            color: var(--accent);
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .hero-shell {
            padding: 5.5rem 0 4rem;
        }

        .hero-title {
            max-width: 760px;
            font-size: clamp(2.55rem, 6vw, 5rem);
            font-weight: 800;
            line-height: 0.98;
        }

        .hero-copy {
            max-width: 620px;
            color: var(--muted);
            font-size: 1.1rem;
            line-height: 1.75;
        }

        .hero-panel,
        .feature-card,
        .article-card,
        .newsletter-panel {
            background: var(--panel-soft);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(12px);
        }

        .hero-panel {
            overflow: hidden;
        }

        .code-window {
            background: #0f172a;
            color: #dbeafe;
            min-height: 360px;
        }

        .window-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #ef4444;
        }

        .window-dot:nth-child(2) {
            background: #f59e0b;
        }

        .window-dot:nth-child(3) {
            background: #22c55e;
        }

        .code-line {
            color: #93c5fd;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.92rem;
            line-height: 1.9;
            white-space: pre-wrap;
        }

        .metric-box {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .feature-card,
        .article-card {
            height: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .feature-card:hover,
        .article-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .icon-box {
            display: inline-flex;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            color: var(--brand);
            background: linear-gradient(135deg, rgba(47, 111, 237, 0.12), rgba(15, 159, 143, 0.12));
            border-radius: 8px;
        }

        .form-control,
        .form-select,
        .input-group-text {
            border-color: var(--line);
            border-radius: 8px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: rgba(47, 111, 237, 0.58);
            box-shadow: 0 0 0 0.22rem rgba(47, 111, 237, 0.14);
        }

        textarea.form-control {
            line-height: 1.7;
        }

        .article-meta {
            color: var(--muted);
            font-size: 0.84rem;
            font-weight: 600;
        }

        .article-card a {
            color: var(--ink);
            text-decoration: none;
        }

        .article-card a:hover {
            color: var(--brand);
        }

        .tag {
            display: inline-flex;
            align-items: center;
            color: #0f766e;
            background: rgba(20, 184, 166, 0.1);
            border: 1px solid rgba(20, 184, 166, 0.18);
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 0.3rem 0.65rem;
        }

        .feed-layout {
            display: grid;
            grid-template-columns: minmax(190px, 236px) minmax(0, 700px) minmax(220px, 292px);
            gap: 1.35rem;
            align-items: start;
        }

        .feed-sidebar {
            position: sticky;
            top: 5.5rem;
        }

        .feed-card,
        .feed-panel {
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: var(--shadow-sm);
            backdrop-filter: blur(14px);
        }

        .feed-card {
            overflow: hidden;
            transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
        }

        .feed-card:hover {
            border-color: rgba(47, 111, 237, 0.22);
            box-shadow: var(--shadow-md);
        }

        .feed-author-photo {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            flex: 0 0 44px;
        }

        .feed-author-fallback {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            font-weight: 800;
            flex: 0 0 44px;
        }

        .feed-image {
            width: 100%;
            max-height: 520px;
            object-fit: cover;
            background: #eef3f8;
        }

        .feed-image-empty {
            min-height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            background:
                linear-gradient(135deg, rgba(47, 111, 237, 0.08), rgba(15, 159, 143, 0.08)),
                #f5f8fb;
        }

        .feed-content {
            color: var(--muted);
            display: -webkit-box;
            -webkit-line-clamp: 8;
            -webkit-box-orient: vertical;
            overflow: hidden;
            white-space: pre-line;
        }

        .feed-action {
            color: #526071;
            background: transparent;
            border: 0;
            border-radius: 8px;
            font-weight: 700;
            padding: 0.76rem 0.75rem;
            text-decoration: none;
            transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
        }

        .feed-action:hover,
        .feed-action:focus {
            color: var(--brand);
            background: rgba(37, 99, 235, 0.07);
            transform: translateY(-1px);
        }

        .feed-action.is-active {
            color: var(--brand);
            background: linear-gradient(135deg, rgba(47, 111, 237, 0.12), rgba(15, 159, 143, 0.1));
        }

        .feed-action-danger:hover,
        .feed-action-danger:focus {
            color: #dc2626;
            background: rgba(220, 38, 38, 0.08);
        }

        .reaction-strip {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            color: var(--muted);
            font-size: 0.86rem;
            border-top: 1px solid var(--line);
            padding: 0.75rem 1rem;
        }

        .reaction-stack {
            display: inline-flex;
            align-items: center;
        }

        .reaction-badge {
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: var(--brand);
            border: 2px solid #fff;
            border-radius: 50%;
            font-size: 0.78rem;
            margin-left: -6px;
        }

        .reaction-badge:first-child {
            margin-left: 0;
        }

        .comment-drawer {
            display: none;
            border-top: 1px solid var(--line);
            background: linear-gradient(180deg, #fbfdff, #f7fafc);
            padding: 1rem;
        }

        .comment-drawer.is-open {
            display: block;
        }

        .comment-input {
            min-height: 44px;
            resize: vertical;
            border-radius: 8px;
        }

        .comment-preview {
            display: none;
            color: var(--ink);
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 0.75rem;
            margin-bottom: 0.75rem;
            white-space: pre-line;
        }

        .comment-preview.has-comment {
            display: block;
        }

        .share-status {
            min-height: 1.2rem;
            color: var(--brand);
            font-size: 0.78rem;
            font-weight: 700;
        }

        .feed-nav-item {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            color: var(--ink);
            border-radius: 8px;
            padding: 0.75rem;
            text-decoration: none;
            font-weight: 700;
        }

        .feed-nav-item:hover,
        .feed-nav-item:focus {
            color: var(--brand);
            background: rgba(47, 111, 237, 0.08);
            transform: translateX(2px);
        }

        .composer-panel {
            position: relative;
            overflow: hidden;
        }

        .composer-panel::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 5px;
            background: linear-gradient(90deg, var(--brand), var(--accent), var(--warm));
        }

        .newsletter-panel {
            background: linear-gradient(135deg, #111827, #1e3a8a);
            color: #fff;
        }

        .footer {
            color: #9ca3af;
            background: #0b1120;
        }

        @media (max-width: 991.98px) {
            .hero-shell {
                padding: 4rem 0 3rem;
            }

            .code-window {
                min-height: auto;
            }

            .feed-layout {
                grid-template-columns: minmax(0, 1fr);
            }

            .feed-sidebar {
                position: static;
            }

            .feed-sidebar-right {
                display: none;
            }
        }

        @media (max-width: 575.98px) {
            .container {
                padding-left: 0.85rem;
                padding-right: 0.85rem;
            }

            .feed-card,
            .feed-panel {
                border-radius: 8px;
            }

            .feed-image {
                max-height: 380px;
            }

            .feed-action {
                font-size: 0.88rem;
                padding-left: 0.35rem;
                padding-right: 0.35rem;
            }

            .reaction-strip {
                align-items: flex-start;
                flex-direction: column;
            }

            .hero-title {
                font-size: 2.45rem;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">TECH<span>BLOG</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="bi bi-house me-1"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/users/profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/posts"><i class="bi bi-file-text me-1"></i>Posts</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/users/register"><i class="bi bi-person-plus me-1"></i>Register</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/users/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
