<%- include('../partials/header') %>

    <%
    const displayName = user && (user.username || user.name) ? (user.username || user.name) : 'Your Profile';
    const initial = displayName.charAt(0).toUpperCase();
    const profilePhoto = user && user.profile_photo ? user.profile_photo : null;
%>

        <main class="py-5">
            <section class="container">
                <% if (error) { %>
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>
                            <%= error %>
                        </div>
                    </div>
                    <% } %>

                        <% if (success) { %>
                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <div>
                                    <%= success %>
                                </div>
                            </div>
                            <% } %>

                                <div class="hero-panel overflow-hidden mb-4">
                                    <div class="p-4 p-md-5 text-white" style="background: linear-gradient(135deg, #111827, #1d4ed8);">
                                        <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-4">
                                            <div class="d-flex align-items-end gap-3">
                                                <% if (profilePhoto) { %>
                                                    <img src="/upload/<%= profilePhoto %>" alt="<%= displayName %>" class="bg-white shadow" style="width:96px;height:96px;border-radius:50%;object-fit:cover;">
                                                    <% } else { %>
                                                        <div class="d-flex align-items-center justify-content-center bg-white text-primary fw-bold shadow" style="width: 96px; height: 96px; border-radius: 50%; font-size: 2.4rem;">
                                                            <%= initial %>
                                                        </div>
                                                        <% } %>
                                                <div>
                                                    <span class="text-white-50 small fw-bold text-uppercase">Member Profile</span>
                                                    <h1 class="fw-bold mb-1">
                                                        <%= displayName %>
                                                    </h1>
                                                    <p class="mb-0 text-white-50">
                                                        <%= user ? user.email : '' %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="text-md-end">
                                                <div class="fs-2 fw-bold">
                                                    <%= posts ? posts.length : 0 %>
                                                </div>
                                                <div class="text-white-50 small">Published posts</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-lg-4">
                                        <div class="hero-panel p-4 mb-4">
                                            <div class="d-flex align-items-center gap-2 mb-3">
                                                <span class="icon-box"><i class="bi bi-person-gear fs-5"></i></span>
                                                <div>
                                                    <h4 class="fw-bold mb-0">Edit Profile</h4>
                                                    <p class="text-muted small mb-0">Update your account information.</p>
                                                </div>
                                            </div>

                                            <form action="/users/profile" method="POST" enctype="multipart/form-data">
                                                <div class="mb-3">
                                                    <label for="username" class="form-label fw-semibold">Name</label>
                                                    <input type="text" id="username" name="username" class="form-control py-2" value="<%= displayName %>" required>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="email" class="form-label fw-semibold">Email</label>
                                                    <input type="email" id="email" name="email" class="form-control py-2" value="<%= user ? user.email : '' %>" required>
                                                </div>

                                                <div class="mb-4">
                                                    <label for="password" class="form-label fw-semibold">New Password</label>
                                                    <input type="password" id="password" name="password" class="form-control py-2" placeholder="Leave blank to keep current">
                                                </div>

                                                <div class="mb-4">
                                                    <label for="profile_photo" class="form-label fw-semibold">Profile Picture <span class="text-muted small">(optional)</span></label>
                                                    <input type="file" id="profile_photo" name="photo" class="form-control py-2" accept="image/*">
                                                </div>

                                                <button type="submit" class="btn btn-brand w-100">
                            <i class="bi bi-check2-circle me-2"></i>Save Profile
                        </button>
                                            </form>
                                        </div>
                                    </div>

                                    <div class="col-lg-8">
                                        <div class="hero-panel p-4 mb-4">
                                            <div class="d-flex align-items-center gap-2 mb-3">
                                                <span class="icon-box"><i class="bi bi-pencil-square fs-5"></i></span>
                                                <div>
                                                    <h4 class="fw-bold mb-0">Create Post</h4>
                                                    <p class="text-muted small mb-0">Share an update with your readers.</p>
                                                </div>
                                            </div>

                                            <form action="/users/profile/posts" method="POST" enctype="multipart/form-data">
                                                <div class="mb-3">
                                                    <label for="title" class="form-label fw-semibold">Title</label>
                                                    <input type="text" id="title" name="title" class="form-control py-2" placeholder="What are you writing about?" required>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="content" class="form-label fw-semibold">Content</label>
                                                    <textarea id="content" name="content" class="form-control" rows="5" placeholder="Write your post..." required></textarea>
                                                </div>
                                                <div class="mb-4">
                                                    <label for="photo" class="form-label fw-semibold">Cover Photo <span class="text-muted small">(optional)</span></label>
                                                    <input type="file" id="photo" class="form-control py-2" name="photo" accept="image/*" />
                                                </div>

                                                <button type="submit" class="btn btn-brand">
                            <i class="bi bi-send me-2"></i>Publish Post
                        </button>
                                            </form>
                                        </div>

                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div>
                                                <span class="section-label">Timeline</span>
                                                <h3 class="fw-bold mb-0">Your Posts</h3>
                                            </div>
                                        </div>

                                        <% if (!posts || posts.length === 0) { %>
                                            <div class="hero-panel p-5 text-center">
                                                <span class="icon-box mb-3"><i class="bi bi-journal-plus fs-5"></i></span>
                                                <h4 class="fw-bold">No posts yet</h4>
                                                <p class="text-muted mb-0">Write your first post from the composer above.</p>
                                            </div>
                                            <% } else { %>
                                                <div class="d-flex flex-column gap-3">
                                                    <% posts.forEach((post) => { %>
                                                        <article class="article-card overflow-hidden">
                                                            <% if (post.photo) { %>
                                                                <img src="/upload/<%= post.photo %>" alt="<%= post.title %>" class="w-100" style="height:260px;object-fit:cover;">
                                                                <% } %>

                                                                    <div class="p-4">
                                                                        <div class="d-flex justify-content-between gap-3">
                                                                            <div>
                                                                                <div class="article-meta mb-2">
                                                                                    <i class="bi bi-clock me-1"></i>
                                                                                    <%= post.created_at ? new Date(post.created_at).toLocaleDateString() : 'Just now' %>
                                                                                </div>
                                                                                <h4 class="fw-bold mb-2">
                                                                                    <%= post.title %>
                                                                                </h4>
                                                                            </div>
                                                                            <form action="/users/profile/posts/<%= post.id %>/delete" method="POST">
                                                                                <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Delete post">
                                                                                    <i class="bi bi-trash"></i>
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                                        <p class="text-muted mb-0">
                                                                            <%= post.content %>
                                                                        </p>
                                                                    </div>
                                                        </article>
                                                        <% }) %>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>
            </section>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        </body>

        </html>
