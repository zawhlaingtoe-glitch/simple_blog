<%- include('../partials/header') %>

    <%
    const displayName = user && (user.username || user.name) ? (user.username || user.name) : 'Your Profile';
    const initial = displayName.charAt(0).toUpperCase();
    const profilePhoto = user && user.profile_photo ? user.profile_photo : null;
%>

        <main class="py-4">
            <section class="container">
                <% if (error) { %>
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>
                            <%= error %>
                        </div>
                    </div>
                    <% } %>

                        <% if (success) { %>
                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <div>
                                    <%= success %>
                                </div>
                            </div>
                            <% } %>

                                <div class="hero-panel overflow-hidden mb-3 animate-scale-in">
                                    <div class="profile-summary-card p-3 p-md-4 text-white">
                                        <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-4">
                                            <div class="d-flex align-items-center gap-3">
                                                <% if (profilePhoto) { %>
                                                    <img src="/upload/<%= profilePhoto %>" alt="<%= displayName %>" class="bg-white shadow" style="width:76px;height:76px;border-radius:50%;object-fit:cover;">
                                                    <% } else { %>
                                                        <div class="d-flex align-items-center justify-content-center fw-bold shadow" style="width:76px;height:76px;border-radius:50%;font-size:1.8rem;background:var(--card-bg);color:var(--brand);">
                                                            <%= initial %>
                                                        </div>
                                                        <% } %>
                                                <div>
                                                    <span class="text-white-50 small fw-bold text-uppercase">Member Profile</span>
                                                    <h1 class="fw-bold mb-1 fs-3">
                                                        <%= displayName %>
                                                    </h1>
                                                    <p class="mb-0 text-white-50">
                                                        <%= user ? user.email : '' %>
                                                    </p>
                                                </div>
                                            </div>
                                            <div class="text-md-end">
                                                <div class="fs-4 fw-bold">
                                                    <%= posts ? posts.length : 0 %>
                                                </div>
                                                <div class="text-white-50 small">Timeline items</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3 profile-layout">
                                    <div class="col-lg-12 animate-fade-in-up delay-200">
                                        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                                            <div>
                                                <span class="section-label">Timeline</span>
                                                <h3 class="fw-bold mb-0">Your Posts</h3>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a href="/users/profile/edit" class="btn btn-outline-brand btn-sm">
                                                    <i class="bi bi-pencil me-1"></i>Edit Profile
                                                </a>
                                                <button class="btn btn-brand btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#profileComposer" aria-expanded="false" aria-controls="profileComposer">
                                                    <i class="bi bi-plus-circle me-2"></i>Create Post
                                                </button>
                                            </div>
                                        </div>

                                        <div class="collapse mb-3" id="profileComposer">
                                            <div class="hero-panel p-3">
                                            <div class="d-flex align-items-center gap-2 mb-3">
                                                <span class="icon-box"><i class="bi bi-pencil-square"></i></span>
                                                <div>
                                                    <h4 class="fw-bold mb-0">Create Post</h4>
                                                    <p class="text-muted small mb-0">Share an update with your readers.</p>
                                                </div>
                                            </div>

                                            <form action="/users/profile/posts" method="POST" enctype="multipart/form-data">
                                                <div class="mb-3">
                                                    <label for="title" class="form-label fw-semibold">Title</label>
                                                    <input type="text" id="title" name="title" class="form-control py-2" placeholder="What are you writing about?" required>
                                                </div>

                                                <div class="mb-3">
                                                    <label for="content" class="form-label fw-semibold">Content</label>
                                                    <textarea id="profile-content" name="content" class="form-control summernote-editor" rows="5" placeholder="Write your post..." required></textarea>
                                                    <div class="form-text" data-editor-status></div>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="visibility" class="form-label fw-semibold">Visibility</label>
                                                    <select id="visibility" name="visibility" class="form-select py-2">
                                                        <option value="public" selected>Public (Everyone can see)</option>
                                                        <option value="private">Private (Only you can see)</option>
                                                    </select>
                                                </div>
                                                <div class="mb-4">
                                                    <label for="photo" class="form-label fw-semibold">Cover Photo <span class="text-muted small">(optional)</span></label>
                                                    <input type="file" id="photo" class="form-control py-2" name="photo" accept="image/*" />
                                                </div>

                                                <button type="submit" class="btn btn-brand btn-sm">
                            <i class="bi bi-send me-2"></i>Publish Post
                        </button>
                                            </form>
                                        </div>
                                        </div>

                                        <% if (!posts || posts.length === 0) { %>
                                            <div class="hero-panel p-5 text-center">
                                                <span class="icon-box mb-3"><i class="bi bi-journal-plus fs-5"></i></span>
                                                <h4 class="fw-bold">No posts yet</h4>
                                                <p class="text-muted mb-0">Write your first post from the composer above.</p>
                                            </div>
                                            <% } else { %>
                                                <div class="profile-post-grid">
                                                    <% posts.forEach((post) => { %>
                                                        <%
                                                            const isSharedPost = post.profile_item_type === 'share';
                                                            const postExcerpt = post.content ? post.content.replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim() : '';
                                                            const postTags = post.tags || [];
                                                        %>
                                                        <article class="article-card profile-post-card overflow-hidden">
                                                            <div class="profile-post-media">
                                                                <% if (post.photo) { %>
                                                                    <img src="/upload/<%= post.photo %>" alt="<%= post.title %>">
                                                                <% } else { %>
                                                                    <div class="h-100 d-flex align-items-center justify-content-center">
                                                                        <span class="icon-box"><i class="bi bi-image"></i></span>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                            <div class="profile-post-content">
                                                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                                                    <div class="min-w-0">
                                                                        <div class="article-meta mb-1">
                                                                            <i class="bi bi-clock me-1"></i>
                                                                            <%= (post.timeline_at || post.created_at) ? new Date(post.timeline_at || post.created_at).toLocaleDateString() : 'Just now' %>
                                                                        </div>
                                                                        <h4 class="fw-bold mb-0 d-flex align-items-center flex-wrap gap-2">
                                                                            <a href="/posts/<%= post.id %>" class="feed-title-link"><%= post.title %></a>
                                                                        </h4>
                                                                        <% if (postTags.length > 0) { %>
                                                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                                                <% postTags.slice(0, 2).forEach(function(tag) { %>
                                                                                    <span class="tag-pill">#<%= tag.name %></span>
                                                                                <% }) %>
                                                                            </div>
                                                                        <% } %>
                                                                    </div>
                                                                    <% if (!isSharedPost) { %>
                                                                        <form action="/users/profile/posts/<%= post.id %>/delete" method="POST">
                                                                            <button type="submit" class="btn btn-outline-danger btn-sm py-1 px-2" aria-label="Delete post">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        </form>
                                                                    <% } %>
                                                                </div>
                                                                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                                                    <% if (isSharedPost) { %>
                                                                        <span class="badge bg-info-subtle text-info-emphasis text-uppercase px-2 py-1 border border-info-subtle" style="font-size:0.62rem;border-radius:4px;"><i class="bi bi-share-fill me-1"></i>Shared</span>
                                                                        <a href="/users/<%= post.user_id %>" class="tag">
                                                                            <% if (post.author_photo) { %>
                                                                                <img src="/upload/<%= post.author_photo %>" alt="<%= post.author %>" class="me-2" style="width:16px;height:16px;border-radius:50%;object-fit:cover;">
                                                                            <% } %>
                                                                            <%= post.author || 'Unknown author' %>
                                                                        </a>
                                                                    <% } else { %>
                                                                        <% if (post.visibility === 'private') { %>
                                                                            <span class="badge bg-warning text-dark text-uppercase px-2 py-1" style="font-size:0.62rem;border-radius:4px;"><i class="bi bi-lock-fill me-1"></i>Private</span>
                                                                        <% } else { %>
                                                                            <span class="badge bg-light text-muted text-uppercase px-2 py-1 border" style="font-size:0.62rem;border-radius:4px;"><i class="bi bi-globe me-1"></i>Public</span>
                                                                        <% } %>
                                                                    <% } %>
                                                                </div>
                                                                <p class="feed-excerpt mb-2"><%= postExcerpt || 'Open the detail page to read this post.' %></p>
                                                                <a href="/posts/<%= post.id %>" class="feed-detail-link">
                                                                    Read detail <i class="bi bi-arrow-right"></i>
                                                                </a>
                                                            </div>
                                                        </article>
                                                        <% }) %>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>
            </section>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
        <script>
            // Accept either a DOM element or jQuery object
            const setEditorStatus = (editor, message, isError = false) => {
                const el = editor.jquery ? editor[0] : editor;
                const status = (el || editor).closest('.mb-3').querySelector('[data-editor-status]');
                if (!status) return;
                status.textContent = message;
                status.classList.toggle('text-danger', isError);
                status.classList.toggle('text-primary', !isError && Boolean(message));
            };

            const uploadSummernoteImage = async(file, editorEl) => {
                const raw = editorEl.jquery ? editorEl[0] : editorEl;

                if (!file.type.startsWith('image/')) {
                    setEditorStatus(raw, 'Please choose an image file.', true);
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    setEditorStatus(raw, 'Image must be smaller than 5 MB.', true);
                    return;
                }

                const formData = new FormData();
                formData.append('photo', file);
                setEditorStatus(raw, 'Uploading image...');

                try {
                    const response = await fetch('/posts/editor-image', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' },
                        body: formData
                    });
                    const data = await response.json();

                    if (!response.ok || !data.url) {
                        setEditorStatus(raw, data.message || 'Image upload failed.', true);
                        return;
                    }

                    $(raw).summernote('insertImage', data.url);
                    setEditorStatus(raw, 'Image added.');
                    setTimeout(() => setEditorStatus(raw, ''), 1800);
                } catch (error) {
                    setEditorStatus(raw, 'Image upload failed. Please try a smaller image.', true);
                }
            };

            // Init once — never destroy/re-init
            let profileEditorInited = false;

            const initProfileEditor = () => {
                if (profileEditorInited) return;
                profileEditorInited = true;

                const editor = $('.summernote-editor');

                editor.summernote({
                    placeholder: 'Write your post...',
                    tabsize: 2,
                    height: 260,
                    dialogsInBody: true,  // ← prevents modals from getting trapped inside collapse
                    toolbar: [
                        ['style', ['style']],
                        ['font', ['bold', 'italic', 'underline', 'clear']],
                        ['para', ['ul', 'ol', 'paragraph']],
                        ['insert', ['link', 'picture']],
                        ['view', ['codeview']]
                    ],
                    callbacks: {
                        onImageUpload: function(files) {
                            Array.from(files).forEach((file) => uploadSummernoteImage(file, this));
                        }
                    }
                });
            };

            const composerEl = document.getElementById('profileComposer');
            if (composerEl) {
                if (composerEl.classList.contains('show')) {
                    // Collapse already open — init on next frame so layout is stable
                    requestAnimationFrame(initProfileEditor);
                }
                composerEl.addEventListener('shown.bs.collapse', initProfileEditor, { once: true });
            }
        </script>
        </body>

        </html>
