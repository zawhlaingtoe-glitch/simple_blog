<%- include('../partials/header') %>

    <main class="auth-page py-5">
        <section class="container">
            <div class="row align-items-center justify-content-between g-5">
                <div class="col-lg-6 animate-fade-in-up">
                    <div class="auth-copy-stack">
                        <span class="section-label d-inline-block mb-3">Create your profile</span>
                        <h1 class="hero-title mb-4">Start writing with TECHBLOG.</h1>
                        <p class="hero-copy mb-4">
                            Register a new account to publish posts, manage your profile, and share practical lessons from your projects.
                        </p>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="auth-benefit p-3">
                                    <span class="icon-box mb-3"><i class="bi bi-pencil-square fs-5"></i></span>
                                    <div>
                                        <h5 class="fw-bold">Publish faster</h5>
                                        <p class="text-muted small mb-0">Turn your notes into readable posts for other developers.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="auth-benefit p-3">
                                    <span class="icon-box mb-3"><i class="bi bi-person-badge fs-5"></i></span>
                                    <div>
                                        <h5 class="fw-bold">Own your work</h5>
                                        <p class="text-muted small mb-0">Keep posts connected to your account and author profile.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="auth-stat-strip mt-4">
                            <div class="auth-stat">
                                <strong>3 min</strong>
                                <span>Setup</span>
                            </div>
                            <div class="auth-stat">
                                <strong>Public</strong>
                                <span>Posts</span>
                            </div>
                            <div class="auth-stat">
                                <strong>Private</strong>
                                <span>Drafts</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5 animate-scale-in delay-200">
                    <div class="auth-card p-4 p-md-5">
                        <div class="mb-4">
                            <span class="icon-box mb-3"><i class="bi bi-person-plus fs-5"></i></span>
                            <h2 class="fw-bold mb-2">Create Account</h2>
                            <p class="text-muted mb-0">Use your name, email, and a secure password.</p>
                        </div>

                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger d-flex align-items-center" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div>
                                    <%= error %>
                                </div>
                            </div>
                            <% } %>

                                <form action="/users/register" method="POST">
                                    <div class="mb-3">
                                        <label for="name" class="form-label fw-semibold">Full Name</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-person text-primary"></i></span>
                                            <input type="text" id="name" name="name" placeholder="Your name" class="form-control py-2">
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="email" class="form-label fw-semibold">Email</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-envelope text-primary"></i></span>
                                            <input type="email" id="email" name="email" placeholder="you@example.com" class="form-control py-2">
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label for="password" class="form-label fw-semibold">Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-lock text-primary"></i></span>
                                            <input type="password" id="password" name="password" placeholder="At least 6 characters" class="form-control py-2">
                                        </div>
                                        <div class="form-text">Choose a password with 6 or more characters.</div>
                                    </div>

                                    <button type="submit" class="btn btn-brand w-100">
                                        <i class="bi bi-person-check me-2"></i>Register
                                    </button>
                                </form>

                                <div class="text-center mt-4 pt-3 border-top">
                                    <p class="text-muted small mb-0">
                                        Already have an account?
                                        <a href="/users/login" class="fw-bold text-decoration-none">Login here</a>
                                    </p>
                                </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>

    </html>
