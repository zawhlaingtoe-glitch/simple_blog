<%- include('../partials/header') %>

<%
const displayName = user && (user.username || user.name) ? (user.username || user.name) : 'Your Profile';
const initial = displayName.charAt(0).toUpperCase();
const profilePhoto = user && user.profile_photo ? user.profile_photo : null;
%>

<main class="py-4">
    <section class="container" style="max-width: 600px;">
        <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div><%= error %></div>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="alert alert-success d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <div><%= success %></div>
            </div>
        <% } %>

        <div class="hero-panel p-3 p-md-4 animate-fade-in-up">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="icon-box"><i class="bi bi-pencil-square"></i></span>
                <div>
                    <h4 class="fw-bold mb-0" style="font-size:1rem;">Edit Profile</h4>
                    <p class="text-muted mb-0" style="font-size:0.78rem;">Update your account information.</p>
                </div>
            </div>

            <form action="/users/profile" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold" style="font-size:0.82rem;">Name</label>
                    <input type="text" id="username" name="username" class="form-control py-2" value="<%= displayName %>" required style="font-size:0.85rem;">
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold" style="font-size:0.82rem;">Email</label>
                    <input type="email" id="email" name="email" class="form-control py-2" value="<%= user ? user.email : '' %>" required style="font-size:0.85rem;">
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold" style="font-size:0.82rem;">New Password</label>
                    <input type="password" id="password" name="password" class="form-control py-2" placeholder="Leave blank to keep current" style="font-size:0.85rem;">
                </div>

                <div class="mb-4">
                    <label for="profile_photo" class="form-label fw-semibold" style="font-size:0.82rem;">Profile Picture <span class="text-muted">(optional)</span></label>
                    <input type="file" id="profile_photo" name="photo" class="form-control py-2" accept="image/*" style="font-size:0.85rem;">
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-brand flex-grow-1">
                        <i class="bi bi-check2-circle me-2"></i>Save Changes
                    </button>
                    <a href="/users/profile" class="btn btn-outline-brand px-3">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </form>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
