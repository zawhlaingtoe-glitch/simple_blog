<%- include('../partials/header') %>

    <main class="py-4 py-md-5">
        <section class="container">
            <div class="feed-layout">
                <aside class="feed-sidebar d-none d-lg-block animate-fade-in-up">
                    <div class="hn-sidebar-card">
                        <a href="/" class="hn-nav-item"><i class="bi bi-house"></i> Home</a>
                        <a href="/users/profile" class="hn-nav-item"><i class="bi bi-person-circle"></i> Profile</a>
                        <a href="/posts/create" class="hn-nav-item"><i class="bi bi-plus-circle"></i> Create Post</a>
                    </div>
                </aside>

                <div class="animate-fade-in-up delay-100">
                    <div class="hn-page-header d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <h1 class="fw-bold mb-1">
                                <% if (typeof activeTag !== 'undefined' && activeTag) { %>
                                    #<%= activeTag.name %>
                                <% } else if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                                    Search: "<%= searchQuery %>"
                                <% } else { %>
                                    Posts
                                <% } %>
                            </h1>
                            <p class="mb-0">Latest updates from the community.</p>
                        </div>
                        <a href="/posts/create" class="btn btn-brand flex-shrink-0">
                            <i class="bi bi-plus-circle me-2"></i>Post
                        </a>
                    </div>

                    <div class="mb-4 live-search-wrapper" id="liveSearchWrapper">
                        <form action="/posts/search" method="GET" role="search" id="searchForm" autocomplete="off">
                            <div class="hn-search-bar">
                                <i class="bi bi-search"></i>
                                <input
                                    type="search"
                                    name="q"
                                    id="liveSearchInput"
                                    value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
                                    placeholder="Search posts by title or content…"
                                    aria-label="Search posts"
                                    aria-autocomplete="list"
                                    aria-controls="liveSearchDropdown"
                                    aria-expanded="false"
                                    spellcheck="false"
                                >
                                <button type="submit">Search</button>
                            </div>
                        </form>
                        <div class="live-search-dropdown" id="liveSearchDropdown" role="listbox" aria-label="Search suggestions"></div>
                        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
                        <div class="small text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i>Found <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %> for "<%= searchQuery %>"
                        </div>
                        <% } %>
                    </div>

                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div><%= error %></div>
                        </div>
                    <% } %>

                    <% if (!posts || posts.length === 0) { %>
                        <div class="hn-card p-5">
                            <div class="hn-empty">
                                <i class="bi bi-journal-plus"></i>
                                <h4>No posts yet</h4>
                                <p>Start the timeline with the first post.</p>
                                <a href="/posts/create" class="btn btn-brand">
                                    <i class="bi bi-plus-circle me-2"></i>Create Post
                                </a>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="d-flex flex-column gap-3">
                            <% posts.forEach(post => {
                                const authorName = post.author || 'Unknown author';
                                const authorInitial = authorName.charAt(0).toUpperCase();
                                const isOwner = typeof currentUserId !== 'undefined' && String(post.user_id) === String(currentUserId);
                                const viewerName = currentUser && currentUser.username ? currentUser.username : 'You';
                                const viewerInitial = viewerName.charAt(0).toUpperCase();
                                const viewerPhoto = currentUser && currentUser.profile_photo ? currentUser.profile_photo : null;
                                const postExcerpt = post.content ? post.content.replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim() : '';
                                const postTags = post.tags || [];
                            %>
                                <article class="hn-card" id="post-<%= post.id %>" data-post-id="<%= post.id %>">
                                    <% if (post.photo) { %>
                                        <div class="hn-card-image-wrap">
                                            <img src="/upload/<%= post.photo %>" alt="<%= post.title %>" loading="lazy">
                                        </div>
                                    <% } else { %>
                                        <div class="hn-card-image-wrap">
                                            <div class="hn-card-placeholder"><i class="bi bi-image"></i></div>
                                        </div>
                                    <% } %>

                                    <div class="hn-card-body">
                                        <div class="hn-author-bar">
                                            <a href="/users/<%= post.user_id %>" class="text-decoration-none">
                                                <% if (post.author_photo) { %>
                                                    <img src="/upload/<%= post.author_photo %>" alt="<%= authorName %>" class="hn-author-avatar">
                                                <% } else { %>
                                                    <span class="hn-author-fallback"><%= authorInitial %></span>
                                                <% } %>
                                            </a>
                                            <div>
                                                <a href="/users/<%= post.user_id %>" class="hn-author-name"><%= authorName %></a>
                                                <div class="hn-author-meta">
                                                    <%= post.created_at ? new Date(post.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Just now' %>
                                                    <span class="dot-sep">·</span>
                                                    <%= locals.readingTime ? locals.readingTime(post.content) : '1 min read' %>
                                                </div>
                                            </div>
                                            <% if (isOwner) { %>
                                                <div class="dropdown ms-auto">
                                                    <button class="hn-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Post options">
                                                        <i class="bi bi-three-dots"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li><a class="dropdown-item" href="/posts/edit/<%= post.id %>"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                                        <li>
                                                            <form action="/posts/delete/<%= post.id %>" method="POST">
                                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            <% } %>
                                        </div>

                                        <a href="/posts/<%= post.id %>" class="hn-card-title">
                                            <%= post.title %>
                                            <% if (post.visibility === 'private') { %>
                                                <span class="hn-badge ms-2"><i class="bi bi-lock-fill"></i>Private</span>
                                            <% } %>
                                        </a>

                                        <% if (postTags.length > 0) { %>
                                            <div class="hn-card-tags">
                                                <% postTags.forEach(function(tag) { %>
                                                    <a href="/posts/tag/<%= tag.slug %>" class="hn-tag"><%= tag.name %></a>
                                                <% }) %>
                                            </div>
                                        <% } %>

                                        <p class="hn-card-excerpt"><%= postExcerpt || 'Open the detail page to read this post.' %></p>
                                    </div>

                                    <div class="hn-card-footer">
                                        <div class="hn-actions">
                                            <button type="button" class="hn-action-btn <%= post.current_user_reacted ? 'is-active' : '' %>" data-reaction-button data-reacted="<%= post.current_user_reacted ? 'true' : 'false' %>">
                                                <i class="bi <%= post.current_user_reacted ? 'bi-hand-thumbs-up-fill' : 'bi-hand-thumbs-up' %>"></i>
                                                <span><%= post.reaction_count || 0 %></span>
                                            </button>
                                            <button type="button" class="hn-action-btn" data-comment-toggle>
                                                <i class="bi bi-chat-left"></i>
                                                <span><%= post.comment_count || 0 %></span>
                                            </button>
                                            <button type="button" class="hn-action-btn <%= post.current_user_shared ? 'is-active' : '' %>" data-share-button data-shared="<%= post.current_user_shared ? 'true' : 'false' %>">
                                                <i class="bi bi-share"></i>
                                                <span style="display:none;"></span>
                                            </button>
                                            <div style="position:relative;">
                                                <button type="button" class="hn-action-btn" data-external-share-toggle>
                                                    <i class="bi bi-box-arrow-up"></i>
                                                </button>
                                                <div class="share-popover" data-external-share-popover>
                                                    <div class="share-header">Share to</div>
                                                    <% const shareUrl = (locals.serverHost || 'http://localhost:3500') + '/posts/' + post.id; %>
                                                    <% const encodedUrl = encodeURIComponent(shareUrl); %>
                                                    <% const encodedTitle = encodeURIComponent(post.title); %>
                                                    <a class="share-option share-option-facebook" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodedUrl %>" target="_blank" rel="noopener noreferrer">
                                                        <i class="bi bi-facebook"></i> Facebook
                                                    </a>
                                                    <a class="share-option share-option-linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodedUrl %>" target="_blank" rel="noopener noreferrer">
                                                        <i class="bi bi-linkedin"></i> LinkedIn
                                                    </a>
                                                    <a class="share-option share-option-twitter" href="https://twitter.com/intent/tweet?text=<%= encodedTitle %>&url=<%= encodedUrl %>" target="_blank" rel="noopener noreferrer">
                                                        <i class="bi bi-twitter-x"></i> X
                                                    </a>
                                                    <a class="share-option share-option-email" href="mailto:?subject=<%= encodedTitle %>&body=Check%20out%20this%20post:%20<%= encodedUrl %>">
                                                        <i class="bi bi-envelope"></i> Email
                                                    </a>
                                                    <div class="share-divider"></div>
                                                    <div class="share-option share-option-copy" data-copy-link="<%= shareUrl %>">
                                                        <i class="bi bi-link-45deg"></i> Copy Link
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <a href="/posts/<%= post.id %>" class="hn-read-link">
                                            Read <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>

                                    <div class="comment-drawer" data-comment-drawer>
                                        <div data-comment-list>
                                            <% if (post.comments && post.comments.length > 0) { %>
                                                <% post.comments.forEach(comment => {
                                                    const commentAuthor = comment.author || 'User';
                                                    const commentInitial = commentAuthor.charAt(0).toUpperCase();
                                                    const replies = comment.replies || [];
                                                %>
                                                    <div class="hn-comment-thread">
                                                        <div class="hn-comment" data-comment-id="<%= comment.id %>">
                                                            <% if (comment.author_photo) { %>
                                                                <img src="/upload/<%= comment.author_photo %>" alt="<%= commentAuthor %>" class="hn-author-avatar" style="width:32px;height:32px;flex:0 0 32px;">
                                                            <% } else { %>
                                                                <span class="hn-author-fallback" style="width:32px;height:32px;flex:0 0 32px;font-size:0.75rem;"><%= commentInitial %></span>
                                                            <% } %>
                                                            <div class="hn-comment-body">
                                                                <div class="hn-comment-author"><%= commentAuthor %></div>
                                                                <div class="hn-comment-text"><%= comment.content %></div>
                                                                <button type="button" class="hn-reply-btn" data-reply-toggle="<%= comment.id %>">Reply</button>
                                                                <div class="reply-box mt-2" data-reply-box="<%= comment.id %>" style="display:none;">
                                                                    <textarea class="form-control" rows="1" placeholder="Write a reply..." data-reply-input="<%= comment.id %>" style="font-size:0.85rem;"></textarea>
                                                                    <button type="button" class="btn btn-brand btn-sm mt-1" data-reply-submit="<%= comment.id %>"><i class="bi bi-send me-1"></i>Reply</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% if (replies.length > 0) { %>
                                                            <div class="hn-reply-thread">
                                                                <% replies.forEach(reply => {
                                                                    const replyAuthor = reply.author || 'User';
                                                                    const replyInitial = replyAuthor.charAt(0).toUpperCase();
                                                                %>
                                                                    <div class="hn-comment" style="border-left:none;">
                                                                        <% if (reply.author_photo) { %>
                                                                            <img src="/upload/<%= reply.author_photo %>" alt="<%= replyAuthor %>" class="hn-author-avatar" style="width:28px;height:28px;flex:0 0 28px;">
                                                                        <% } else { %>
                                                                            <span class="hn-author-fallback" style="width:28px;height:28px;flex:0 0 28px;font-size:0.7rem;"><%= replyInitial %></span>
                                                                        <% } %>
                                                                        <div class="hn-comment-body">
                                                                            <div class="hn-comment-author"><%= replyAuthor %></div>
                                                                            <div class="hn-comment-text"><%= reply.content %></div>
                                                                        </div>
                                                                    </div>
                                                                <% }) %>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                <% }) %>
                                            <% } %>
                                        </div>
                                        <div class="hn-comment-input-wrap">
                                            <% if (viewerPhoto) { %>
                                                <img src="/upload/<%= viewerPhoto %>" alt="<%= viewerName %>" class="hn-author-avatar">
                                            <% } else { %>
                                                <span class="hn-author-fallback"><%= viewerInitial %></span>
                                            <% } %>
                                            <div class="hn-comment-box">
                                                <textarea rows="1" placeholder="Write a comment..." data-comment-input></textarea>
                                                <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                                    <span class="share-status" data-share-status></span>
                                                    <button type="button" class="btn btn-brand btn-sm hn-comment-submit" data-comment-submit>
                                                        <i class="bi bi-send me-1"></i>Post
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>

                    <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
                        <nav aria-label="Page navigation">
                            <div class="hn-pagination">
                                <%
                                    var baseUrl, pageSep;
                                    if (typeof searchQuery !== 'undefined' && searchQuery) {
                                        baseUrl = '/posts/search?q=' + encodeURIComponent(searchQuery);
                                        pageSep = '&';
                                    } else if (typeof activeTag !== 'undefined' && activeTag) {
                                        baseUrl = '/posts/tag/' + activeTag.slug;
                                        pageSep = '?';
                                    } else {
                                        baseUrl = '/posts';
                                        pageSep = '?';
                                    }
                                %>
                                <a class="hn-page-btn <%= pagination.page <= 1 ? 'disabled' : '' %>" href="<%= baseUrl %><%= pageSep %>page=<%= pagination.page - 1 %>">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                                    <a class="hn-page-btn <%= p === pagination.page ? 'active' : '' %>" href="<%= baseUrl %><%= pageSep %>page=<%= p %>"><%= p %></a>
                                <% } %>
                                <a class="hn-page-btn <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>" href="<%= baseUrl %><%= pageSep %>page=<%= pagination.page + 1 %>">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </div>
                        </nav>
                    <% } %>
                </div>

                <aside class="feed-sidebar feed-sidebar-right animate-fade-in-up delay-200">
                    <% if (typeof popularTags !== 'undefined' && popularTags && popularTags.length > 0) { %>
                        <div class="hn-sidebar-card">
                            <div class="hn-sidebar-label">Popular tags</div>
                            <div class="hn-sidebar-tags">
                                <% popularTags.forEach(function(tag) { %>
                                    <a href="/posts/tag/<%= tag.slug %>" class="hn-sidebar-tag"><%= tag.name %></a>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                    <div class="hn-sidebar-card">
                        <div class="hn-sidebar-label">Stats</div>
                        <div class="small text-muted">
                            <i class="bi bi-file-text me-1"></i> <%= pagination.total %> posts
                        </div>
                    </div>
                    <div class="hn-sidebar-card">
                        <div class="hn-sidebar-label">Tip</div>
                        <p class="text-muted small mb-0">Click on tags to discover related content from the community.</p>
                    </div>
                </aside>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.hn-card').forEach((card) => {
            const postId = card.dataset.postId;
            const reactionButton = card.querySelector('[data-reaction-button]');
            const commentToggle = card.querySelector('[data-comment-toggle]');
            const commentDrawer = card.querySelector('[data-comment-drawer]');
            const commentInput = card.querySelector('[data-comment-input]');
            const commentSubmit = card.querySelector('[data-comment-submit]');
            const commentList = card.querySelector('[data-comment-list]');
            const shareButton = card.querySelector('[data-share-button]');
            const shareStatus = card.querySelector('[data-share-status]');

            const goLogin = () => {
                window.location.href = '/users/login';
            };
            const postJson = async(url, body = {}) => {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(body)
                });

                if (response.redirected || response.status === 401 || response.status === 403) {
                    goLogin();
                    return null;
                }

                return response.json();
            };

            const updateCounts = (counts) => {
                if (!counts) return;
                // Update reaction count on the button
                if (reactionButton && counts.reactions !== undefined) {
                    const span = reactionButton.querySelector('span');
                    if (span) span.textContent = counts.reactions;
                }
                // Update comment count on the button
                if (commentToggle && counts.comments !== undefined) {
                    const span = commentToggle.querySelector('span');
                    if (span) span.textContent = counts.comments;
                }
                // Update share button active state from counts response
                if (shareButton && counts.current_user_shared !== undefined) {
                    const isShared = counts.current_user_shared;
                    shareButton.classList.toggle('is-active', isShared);
                    shareButton.dataset.shared = isShared ? 'true' : 'false';
                }
            };

            reactionButton?.addEventListener('click', async() => {
                const data = await postJson(`/posts/${postId}/reactions`, { reaction_type: 'like' });
                if (!data) return;

                reactionButton.classList.toggle('is-active', data.reacted);
                reactionButton.dataset.reacted = data.reacted ? 'true' : 'false';
                reactionButton.querySelector('i').className = data.reacted ? 'bi bi-hand-thumbs-up-fill' : 'bi bi-hand-thumbs-up';
                if (data.counts && data.counts.reactions !== undefined) {
                    reactionButton.querySelector('span').textContent = data.counts.reactions;
                }
                if (reactionUsers && data.counts && data.counts.reactionUsers) {
                    reactionUsers.textContent = data.counts.reactionUsers.length > 0 ?
                        `Liked by ${data.counts.reactionUsers.map((user) => user.author).join(', ')}` :
                        '';
                }
            });

            commentToggle?.addEventListener('click', () => {
                commentDrawer.classList.toggle('is-open');
                commentToggle.classList.toggle('is-active', commentDrawer.classList.contains('is-open'));
                if (commentDrawer.classList.contains('is-open')) {
                    commentInput.focus();
                }
            });

            commentSubmit?.addEventListener('click', async() => {
                const comment = commentInput.value.trim();
                if (!comment) {
                    commentInput.focus();
                    return;
                }

                const data = await postJson(`/posts/${postId}/comments`, { content: comment });
                if (!data) return;

                const commentAuthor = data.comment.author || 'User';
                const commentInitial = commentAuthor.charAt(0).toUpperCase();
                const commentItem = document.createElement('div');
                commentItem.className = 'hn-comment-thread';
                commentItem.innerHTML = `
                    <div class="hn-comment">
                        ${data.comment.author_photo
                            ? `<img src="/upload/${data.comment.author_photo}" alt="${commentAuthor}" class="hn-author-avatar" style="width:32px;height:32px;flex:0 0 32px;">`
                            : `<span class="hn-author-fallback" style="width:32px;height:32px;flex:0 0 32px;font-size:0.75rem;">${commentInitial}</span>`
                        }
                        <div class="hn-comment-body">
                            <div class="hn-comment-author">${commentAuthor}</div>
                            <div class="hn-comment-text">${data.comment.content}</div>
                            <button type="button" class="hn-reply-btn" data-reply-toggle="${data.comment.id}">Reply</button>
                            <div class="reply-box mt-2" data-reply-box="${data.comment.id}" style="display:none;">
                                <textarea class="form-control" rows="1" placeholder="Write a reply..." data-reply-input="${data.comment.id}" style="font-size:0.85rem;"></textarea>
                                <button type="button" class="btn btn-brand btn-sm mt-1" data-reply-submit="${data.comment.id}"><i class="bi bi-send me-1"></i>Reply</button>
                            </div>
                        </div>
                    </div>
                `;
                // Wire up reply toggle for new comment
                const replyToggle = commentItem.querySelector('[data-reply-toggle]');
                const replyBox = commentItem.querySelector('[data-reply-box]');
                replyToggle?.addEventListener('click', () => {
                    const box = document.querySelector(`[data-reply-box="${replyToggle.dataset.replyToggle}"]`);
                    if (box) {
                        box.style.display = box.style.display === 'none' ? 'block' : 'none';
                        if (box.style.display === 'block') box.querySelector('textarea').focus();
                    }
                });
                // Wire up reply submit for new comment
                const replySubmit = commentItem.querySelector('[data-reply-submit]');
                replySubmit?.addEventListener('click', handleReplySubmit);

                commentList.appendChild(commentItem);
                commentInput.value = '';
                updateCounts(data.counts);
            });

            // Share toggle
            shareButton?.addEventListener('click', async() => {
                const data = await postJson(`/posts/${postId}/shares`);
                if (!data) return;

                const isShared = data.shared;
                shareButton.classList.toggle('is-active', isShared);
                shareButton.dataset.shared = isShared ? 'true' : 'false';
                updateCounts(data.counts);
                shareStatus.textContent = isShared ? 'Shared to profile. Tap again to unshare.' : 'Removed from profile.';
                setTimeout(() => {
                    shareStatus.textContent = '';
                }, 1800);
            });

            // Reply toggle buttons
            card.querySelectorAll('[data-reply-toggle]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const box = document.querySelector(`[data-reply-box="${btn.dataset.replyToggle}"]`);
                    if (box) {
                        box.style.display = box.style.display === 'none' ? 'block' : 'none';
                        if (box.style.display === 'block') box.querySelector('textarea').focus();
                    }
                });
            });

            // Reply submit handler
            const handleReplySubmit = async(btn) => {
                const targetId = btn.target?.dataset?.replySubmit || btn.dataset?.replySubmit;
                if (!targetId) return;
                const input = document.querySelector(`[data-reply-input="${targetId}"]`);
                if (!input) return;
                const replyContent = input.value.trim();
                if (!replyContent) { input.focus(); return; }

                const data = await postJson(`/posts/${postId}/comments/${targetId}/reply`, { content: replyContent });
                if (!data) return;

                const replyAuthor = data.comment.author || 'User';
                const replyInitial = replyAuthor.charAt(0).toUpperCase();
                const replyItem = document.createElement('div');
                replyItem.className = 'hn-comment';
                replyItem.style = 'border-left:none;';
                replyItem.innerHTML = `
                    ${data.comment.author_photo
                        ? `<img src="/upload/${data.comment.author_photo}" alt="${replyAuthor}" class="hn-author-avatar" style="width:28px;height:28px;flex:0 0 28px;">`
                        : `<span class="hn-author-fallback" style="width:28px;height:28px;flex:0 0 28px;font-size:0.7rem;">${replyInitial}</span>`
                    }
                    <div class="hn-comment-body">
                        <div class="hn-comment-author">${replyAuthor}</div>
                        <div class="hn-comment-text">${data.comment.content}</div>
                    </div>
                `;
                const parentComment = card.querySelector(`[data-comment-id="${targetId}"]`);
                if (parentComment) {
                    let replyThread = parentComment.parentElement.querySelector('.hn-reply-thread');
                    if (!replyThread) {
                        replyThread = document.createElement('div');
                        replyThread.className = 'hn-reply-thread';
                        parentComment.after(replyThread);
                    }
                    replyThread.appendChild(replyItem);
                }
                input.value = '';
                document.querySelector(`[data-reply-box="${targetId}"]`).style.display = 'none';
                updateCounts(data.counts);
            };

            card.querySelectorAll('[data-reply-submit]').forEach(btn => {
                btn.addEventListener('click', (e) => handleReplySubmit(e.currentTarget));
            });

            // External share toggle
            const extShareToggle = card.querySelector('[data-external-share-toggle]');
            const extSharePopover = card.querySelector('[data-external-share-popover]');
            if (extShareToggle && extSharePopover) {
                extShareToggle.addEventListener('click', (e) => {
                    e.stopPropagation();
                    // Close all other open share popovers
                    document.querySelectorAll('[data-external-share-popover].is-open').forEach(p => {
                        if (p !== extSharePopover) p.classList.remove('is-open');
                    });
                    extSharePopover.classList.toggle('is-open');
                });
                // Copy link
                extSharePopover.querySelector('[data-copy-link]')?.addEventListener('click', async (e) => {
                    e.preventDefault();
                    try {
                        await navigator.clipboard.writeText(e.currentTarget.dataset.copyLink);
                        const original = e.currentTarget.innerHTML;
                        e.currentTarget.innerHTML = '<i class="bi bi-check-lg"></i> Copied!';
                        setTimeout(() => { e.currentTarget.innerHTML = original; }, 1500);
                    } catch (err) {
                        prompt('Copy this link:', e.currentTarget.dataset.copyLink);
                    }
                });
            }
        });

        // Close share popovers on outside click
        document.addEventListener('click', () => {
            document.querySelectorAll('[data-external-share-popover].is-open').forEach(p => p.classList.remove('is-open'));
        });

        /* ── Live Search ── */
        (function() {
            const input    = document.getElementById('liveSearchInput');
            const dropdown = document.getElementById('liveSearchDropdown');
            const clearBtn = document.getElementById('liveSearchClear');
            const form     = document.getElementById('searchForm');
            if (!input || !dropdown) return;

            let debounceTimer = null;
            let currentQuery  = '';
            let focusedIndex  = -1;

            // Highlight matched text
            function highlight(text, query) {
                if (!query) return text;
                const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                return text.replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
            }

            function getItems() {
                return dropdown.querySelectorAll('.ls-result');
            }

            function setFocus(idx) {
                const items = getItems();
                items.forEach((el, i) => el.classList.toggle('is-focused', i === idx));
                focusedIndex = idx;
            }

            function openDropdown() {
                dropdown.classList.add('is-open');
                input.setAttribute('aria-expanded', 'true');
            }

            function closeDropdown() {
                dropdown.classList.remove('is-open');
                input.setAttribute('aria-expanded', 'false');
                focusedIndex = -1;
            }

            function renderLoading() {
                dropdown.innerHTML = `<div class="ls-loading"><div class="ls-spinner"></div>Searching…</div>`;
                openDropdown();
            }

            function renderResults(data) {
                const { results, query } = data;

                if (!results || results.length === 0) {
                    dropdown.innerHTML = `
                        <div class="ls-empty">
                            <i class="bi bi-search" style="font-size:1.3rem;opacity:0.3;display:block;margin-bottom:0.3rem;"></i>
                            No posts found for <strong>"${query}"</strong>
                        </div>`;
                    openDropdown();
                    return;
                }

                const items = results.map((r, i) => {
                    const thumb = r.photo
                        ? `<img class="ls-thumb" src="/upload/${r.photo}" alt="${r.title}" loading="lazy">`
                        : `<div class="ls-thumb-fallback"><i class="bi bi-file-text"></i></div>`;

                    const tags = r.tags && r.tags.length
                        ? `<div class="ls-tags">${r.tags.map(t => `<span class="ls-tag">#${t}</span>`).join('')}</div>`
                        : '';

                    return `
                        <a class="ls-result" href="${r.url}" role="option" tabindex="-1" data-ls-index="${i}">
                            ${thumb}
                            <div class="ls-body">
                                <div class="ls-title">${highlight(r.title, query)}</div>
                                <div class="ls-meta">by ${r.author}${r.excerpt ? ' · ' + r.excerpt : ''}</div>
                                ${tags}
                            </div>
                        </a>`;
                }).join('');

                dropdown.innerHTML = `
                    <div class="ls-header">
                        Results
                        <span class="ls-count">${results.length}</span>
                    </div>
                    ${items}
                    <a class="ls-footer" href="/posts/search?q=${encodeURIComponent(query)}">
                        <i class="bi bi-search"></i> See all results for "${query}"
                    </a>`;

                openDropdown();
            }

            async function doSearch(q) {
                if (!q) { closeDropdown(); return; }
                currentQuery = q;
                renderLoading();

                try {
                    const res = await fetch(`/posts/search/live?q=${encodeURIComponent(q)}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await res.json();
                    // Ignore stale response if query changed
                    if (data.query !== currentQuery && data.query !== undefined) return;
                    renderResults({ results: data.results, query: q });
                } catch (e) {
                    dropdown.innerHTML = `<div class="ls-empty">Something went wrong. Try again.</div>`;
                }
            }

            // Toggle clear button visibility
            function syncClear() {
                if (clearBtn) {
                    clearBtn.style.display = input.value.length > 0 ? 'inline-flex' : 'none';
                }
            }

            input.addEventListener('input', () => {
                syncClear();
                const q = input.value.trim();
                clearTimeout(debounceTimer);
                if (!q) { closeDropdown(); return; }
                debounceTimer = setTimeout(() => doSearch(q), 220);
            });

            clearBtn?.addEventListener('click', () => {
                input.value = '';
                syncClear();
                closeDropdown();
                input.focus();
            });

            // Keyboard navigation
            input.addEventListener('keydown', (e) => {
                const items = getItems();
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    setFocus(Math.min(focusedIndex + 1, items.length - 1));
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    setFocus(Math.max(focusedIndex - 1, -1));
                } else if (e.key === 'Enter' && focusedIndex >= 0) {
                    e.preventDefault();
                    items[focusedIndex]?.click();
                } else if (e.key === 'Escape') {
                    closeDropdown();
                    input.blur();
                }
            });

            // Close on outside click
            document.addEventListener('click', (e) => {
                if (!e.target.closest('#liveSearchWrapper')) closeDropdown();
            });

            // Reopen on focus if there's content
            input.addEventListener('focus', () => {
                if (input.value.trim()) doSearch(input.value.trim());
            });

            // Init clear button state
            syncClear();
        })();
    </script>

    </body>

    </html>
