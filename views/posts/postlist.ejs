<%- include('../partials/header') %>

    <main class="py-4 py-md-5">
        <section class="container">
            <div class="feed-layout">
                <aside class="feed-sidebar d-none d-lg-block animate-fade-in-up">
                    <div class="feed-panel p-3">
                        <a href="/" class="feed-nav-item">
                            <span class="icon-box"><i class="bi bi-house"></i></span>
                            Home
                        </a>
                        <a href="/users/profile" class="feed-nav-item">
                            <span class="icon-box"><i class="bi bi-person-circle"></i></span>
                            Profile
                        </a>
                        <a href="/posts/create" class="feed-nav-item">
                            <span class="icon-box"><i class="bi bi-plus-circle"></i></span>
                            Create Post
                        </a>
                    </div>
                </aside>

                <div class="animate-fade-in-up delay-100">
                    <div class="feed-panel p-3 p-sm-4 mb-3">
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            <div>
                                <span class="section-label">Newsfeed</span>
                                <h1 class="fw-bold mb-1">Posts</h1>
                                <p class="text-muted small mb-0">Latest updates from the community.</p>
                            </div>
                            <a href="/posts/create" class="btn btn-brand flex-shrink-0">
                                <i class="bi bi-plus-circle me-2"></i>Post
                            </a>
                        </div>
                    </div>

                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div><%= error %></div>
                        </div>
                        <% } %>

                            <% if (!posts || posts.length === 0) { %>
                                <div class="feed-card p-5 text-center">
                                    <span class="icon-box mb-3"><i class="bi bi-journal-plus fs-5"></i></span>
                                    <h4 class="fw-bold">No posts yet</h4>
                                    <p class="text-muted mb-4">Start the timeline with the first post.</p>
                                    <a href="/posts/create" class="btn btn-brand">
                                        <i class="bi bi-plus-circle me-2"></i>Create Post
                                    </a>
                                </div>
                                <% } else { %>
                                    <div class="d-flex flex-column gap-3">
                                        <% posts.forEach(post => {
                                            const authorName = post.author || 'Unknown author';
                                            const authorInitial = authorName.charAt(0).toUpperCase();
                                            const isOwner = typeof currentUserId !== 'undefined' && String(post.user_id) === String(currentUserId);
                                            const viewerName = currentUser && currentUser.username ? currentUser.username : 'You';
                                            const viewerInitial = viewerName.charAt(0).toUpperCase();
                                            const viewerPhoto = currentUser && currentUser.profile_photo ? currentUser.profile_photo : null;
                                        %>
                                            <article class="feed-card" id="post-<%= post.id %>" data-post-id="<%= post.id %>">
                                                <div class="p-3 p-sm-4">
                                                    <div class="d-flex align-items-start justify-content-between gap-3">
                                                        <a href="/users/<%= post.user_id %>" class="d-flex align-items-center gap-2 min-w-0 text-decoration-none text-reset">
                                                            <% if (post.author_photo) { %>
                                                                <img src="/upload/<%= post.author_photo %>" alt="<%= authorName %>" class="feed-author-photo">
                                                                <% } else { %>
                                                                    <span class="feed-author-fallback"><%= authorInitial %></span>
                                                                    <% } %>
                                                                        <div>
                                                                            <h6 class="fw-bold mb-0"><%= authorName %></h6>
                                                                            <div class="article-meta">
                                                                                <i class="bi bi-clock me-1"></i>
                                                                                <%= post.created_at ? new Date(post.created_at).toLocaleDateString() : 'Just now' %>
                                                                            </div>
                                                                        </div>
                                                        </a>

                                                        <% if (isOwner) { %>
                                                            <div class="dropdown">
                                                                <button class="btn btn-outline-brand btn-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Post options">
                                                                    <i class="bi bi-three-dots"></i>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-end">
                                                                    <li><a class="dropdown-item" href="/posts/edit/<%= post.id %>"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                                                    <li>
                                                                        <form action="/posts/delete/<%= post.id %>" method="POST">
                                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                                                                        </form>
                                                                    </li>
                                                                </ul>
                                                            </div>
                                                            <% } %>
                                                    </div>

                                                    <h4 class="fw-bold mt-3 mb-2 d-flex align-items-center flex-wrap gap-2">
                                                        <%= post.title %>
                                                        <% if (post.visibility === 'private') { %>
                                                            <span class="badge bg-warning text-dark"><i class="bi bi-lock-fill me-1"></i>Private</span>
                                                        <% } %>
                                                    </h4>
                                                    <div class="feed-content mb-0"><%- post.content %></div>
                                                </div>

                                                <% if (post.photo) { %>
                                                    <img src="/upload/<%= post.photo %>" alt="<%= post.title %>" class="feed-image">
                                                    <% } else { %>
                                                        <div class="feed-image-empty">
                                                            <span class="icon-box" style="width:56px;height:56px;"><i class="bi bi-image fs-4"></i></span>
                                                        </div>
                                                        <% } %>

                                                            <div class="reaction-strip">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <span class="reaction-stack" aria-hidden="true">
                                                                        <span class="reaction-badge"><i class="bi bi-hand-thumbs-up-fill"></i></span>
                                                                        <span class="reaction-badge" style="background:#ef4444;"><i class="bi bi-heart-fill"></i></span>
                                                                    </span>
                                                                    <span>
                                                                        <span data-reaction-count><%= post.reaction_count || 0 %> <%= Number(post.reaction_count) === 1 ? 'reaction' : 'reactions' %></span>
                                                                        <% if (post.reaction_users && post.reaction_users.length > 0) { %>
                                                                            <span class="d-block small" data-reaction-users>
                                                                                Liked by <%= post.reaction_users.map(user => user.author).join(', ') %>
                                                                            </span>
                                                                            <% } else { %>
                                                                                <span class="d-block small" data-reaction-users></span>
                                                                                <% } %>
                                                                    </span>
                                                                </div>
                                                                <div>
                                                                    <span data-comment-count><%= post.comment_count || 0 %> <%= Number(post.comment_count) === 1 ? 'comment' : 'comments' %></span>
                                                                    <span class="mx-1">/</span>
                                                                    <span data-share-count><%= post.share_count || 0 %> <%= Number(post.share_count) === 1 ? 'share' : 'shares' %></span>
                                                                </div>
                                                            </div>

                                                            <div class="p-2 border-top">
                                                                <div class="d-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
                                                                    <button type="button" class="feed-action <%= post.current_user_reacted ? 'is-active' : '' %>" data-reaction-button data-reacted="<%= post.current_user_reacted ? 'true' : 'false' %>">
                                                                        <i class="bi <%= post.current_user_reacted ? 'bi-hand-thumbs-up-fill' : 'bi-hand-thumbs-up' %> me-1"></i><span><%= post.current_user_reacted ? 'Reacted' : 'React' %></span>
                                                                    </button>
                                                                    <button type="button" class="feed-action" data-comment-toggle>
                                                                        <i class="bi bi-chat-left me-1"></i><span>Comment</span>
                                                                    </button>
                                                                    <button type="button" class="feed-action" data-share-button data-share-url="/posts#post-<%= post.id %>">
                                                                        <i class="bi bi-share me-1"></i><span>Share</span>
                                                                    </button>
                                                                </div>
                                                            </div>

                                                            <div class="comment-drawer" data-comment-drawer>
                                                                <div data-comment-list>
                                                                    <% if (post.comments && post.comments.length > 0) { %>
                                                                        <% post.comments.forEach(comment => {
                                                                            const commentAuthor = comment.author || 'User';
                                                                            const commentInitial = commentAuthor.charAt(0).toUpperCase();
                                                                        %>
                                                                            <div class="comment-preview has-comment">
                                                                                <div class="d-flex align-items-start gap-2">
                                                                                    <% if (comment.author_photo) { %>
                                                                                        <img src="/upload/<%= comment.author_photo %>" alt="<%= commentAuthor %>" style="width:30px;height:30px;border-radius:50%;object-fit:cover;">
                                                                                        <% } else { %>
                                                                                            <span class="feed-author-fallback" style="width:30px;height:30px;flex-basis:30px;font-size:0.78rem;"><%= commentInitial %></span>
                                                                                            <% } %>
                                                                                                <div>
                                                                                                    <div class="fw-bold small"><%= commentAuthor %></div>
                                                                                                    <div><%= comment.content %></div>
                                                                                                </div>
                                                                                </div>
                                                                            </div>
                                                                            <% }) %>
                                                                                <% } %>
                                                                </div>
                                                                <div class="d-flex align-items-start gap-2">
                                                                    <% if (viewerPhoto) { %>
                                                                        <img src="/upload/<%= viewerPhoto %>" alt="<%= viewerName %>" class="feed-author-photo" style="width:36px;height:36px;flex-basis:36px;">
                                                                        <% } else { %>
                                                                            <span class="feed-author-fallback" style="width:36px;height:36px;flex-basis:36px;font-size:0.9rem;"><%= viewerInitial %></span>
                                                                            <% } %>
                                                                                <div class="flex-grow-1">
                                                                                    <textarea class="form-control comment-input" rows="1" placeholder="Write a comment..." data-comment-input></textarea>
                                                                                    <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                                                                        <span class="share-status" data-share-status></span>
                                                                                        <button type="button" class="btn btn-brand btn-sm" data-comment-submit>
                                                                                            <i class="bi bi-send me-1"></i>Post
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                </div>
                                                            </div>
                                            </article>
                                            <% }) %>
                                    </div>
                                    <% } %>
                </div>

                <aside class="feed-sidebar feed-sidebar-right animate-fade-in-up delay-200">
                    <div class="feed-panel p-4 mb-3">
                        <span class="section-label">Comfort next</span>
                        <h5 class="fw-bold mt-2">Polish checklist</h5>
                        <p class="text-muted small mb-3">Small features that make the project feel complete.</p>
                        <div class="d-flex flex-column gap-2 small text-muted">
                            <div><i class="bi bi-check-circle text-primary me-2"></i>Mobile-first feed layout</div>
                            <div><i class="bi bi-check-circle text-primary me-2"></i>Owner-only edit/delete</div>
                            <div><i class="bi bi-circle me-2"></i>Comments</div>
                            <div><i class="bi bi-circle me-2"></i>Likes</div>
                            <div><i class="bi bi-circle me-2"></i>Search posts</div>
                        </div>
                    </div>
                    <div class="feed-panel p-4">
                        <span class="section-label">Tip</span>
                        <p class="text-muted small mt-2 mb-0">Keep actions close to each post and avoid showing controls users cannot use.</p>
                    </div>
                </aside>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.feed-card').forEach((card) => {
            const postId = card.dataset.postId;
            const reactionButton = card.querySelector('[data-reaction-button]');
            const reactionCount = card.querySelector('[data-reaction-count]');
            const reactionUsers = card.querySelector('[data-reaction-users]');
            const commentToggle = card.querySelector('[data-comment-toggle]');
            const commentDrawer = card.querySelector('[data-comment-drawer]');
            const commentInput = card.querySelector('[data-comment-input]');
            const commentSubmit = card.querySelector('[data-comment-submit]');
            const commentList = card.querySelector('[data-comment-list]');
            const commentCount = card.querySelector('[data-comment-count]');
            const shareButton = card.querySelector('[data-share-button]');
            const shareCount = card.querySelector('[data-share-count]');
            const shareStatus = card.querySelector('[data-share-status]');

            const pluralize = (count, word) => `${count} ${word}${count === 1 ? '' : 's'}`;
            const goLogin = () => {
                window.location.href = '/users/login';
            };
            const postJson = async(url, body = {}) => {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(body)
                });

                if (response.redirected || response.status === 401 || response.status === 403) {
                    goLogin();
                    return null;
                }

                return response.json();
            };

            const updateCounts = (counts) => {
                if (!counts) return;
                reactionCount.textContent = pluralize(Number(counts.reactions || 0), 'reaction');
                commentCount.textContent = pluralize(Number(counts.comments || 0), 'comment');
                shareCount.textContent = pluralize(Number(counts.shares || 0), 'share');
                if (reactionUsers && counts.reactionUsers) {
                    reactionUsers.textContent = counts.reactionUsers.length > 0 ?
                        `Liked by ${counts.reactionUsers.map((user) => user.author).join(', ')}` :
                        '';
                }
            };

            reactionButton?.addEventListener('click', async() => {
                const data = await postJson(`/posts/${postId}/reactions`, { reaction_type: 'like' });
                if (!data) return;

                reactionButton.classList.toggle('is-active', data.reacted);
                reactionButton.dataset.reacted = data.reacted ? 'true' : 'false';
                reactionButton.querySelector('span').textContent = data.reacted ? 'Reacted' : 'React';
                reactionButton.querySelector('i').className = data.reacted ? 'bi bi-hand-thumbs-up-fill me-1' : 'bi bi-hand-thumbs-up me-1';
                updateCounts(data.counts);
            });

            commentToggle?.addEventListener('click', () => {
                commentDrawer.classList.toggle('is-open');
                commentToggle.classList.toggle('is-active', commentDrawer.classList.contains('is-open'));
                if (commentDrawer.classList.contains('is-open')) {
                    commentInput.focus();
                }
            });

            commentSubmit?.addEventListener('click', async() => {
                const comment = commentInput.value.trim();
                if (!comment) {
                    commentInput.focus();
                    return;
                }

                const data = await postJson(`/posts/${postId}/comments`, { content: comment });
                if (!data) return;

                const commentAuthor = data.comment.author || 'User';
                const commentInitial = commentAuthor.charAt(0).toUpperCase();
                const commentItem = document.createElement('div');
                commentItem.className = 'comment-preview has-comment';
                commentItem.innerHTML = `
                    <div class="d-flex align-items-start gap-2">
                        ${data.comment.author_photo
                            ? `<img src="/upload/${data.comment.author_photo}" alt="${commentAuthor}" style="width:30px;height:30px;border-radius:50%;object-fit:cover;">`
                            : `<span class="feed-author-fallback" style="width:30px;height:30px;flex-basis:30px;font-size:0.78rem;">${commentInitial}</span>`
                        }
                        <div>
                            <div class="fw-bold small"></div>
                            <div></div>
                        </div>
                    </div>
                `;
                commentItem.querySelector('.fw-bold').textContent = commentAuthor;
                commentItem.querySelector('.fw-bold + div').textContent = data.comment.content;
                commentList.appendChild(commentItem);
                commentInput.value = '';
                updateCounts(data.counts);
            });

            shareButton?.addEventListener('click', async() => {
                const shareUrl = `${window.location.origin}${shareButton.dataset.shareUrl}`;
                const data = await postJson(`/posts/${postId}/shares`);
                if (!data) return;

                try {
                    await navigator.clipboard.writeText(shareUrl);
                    updateCounts(data.counts);
                    shareButton.classList.add('is-active');
                    shareStatus.textContent = 'Shared to profile. Link copied';
                    setTimeout(() => {
                        shareStatus.textContent = '';
                        shareButton.classList.remove('is-active');
                    }, 1800);
                } catch (_error) {
                    shareStatus.textContent = shareUrl;
                }
            });
        });
    </script>

    </body>

    </html>
