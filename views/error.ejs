<%- include('partials/header') %>

<main class="py-5">
    <section class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center animate-fade-in-up">
                <span class="icon-box mb-3" style="width: 72px; height: 72px; font-size: 1.6rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </span>
                <h1 class="fw-bold display-6 mb-2"><%= typeof statusCode !== 'undefined' ? statusCode : 'Error' %></h1>
                <p class="text-muted mb-4"><%= typeof message !== 'undefined' ? message : 'Something went wrong.' %></p>
                <a href="/" class="btn btn-brand"><i class="bi bi-house me-2"></i>Back to Home</a>
            </div>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
